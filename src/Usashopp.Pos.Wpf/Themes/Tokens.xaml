<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================= COLORES (tema claro, estilo Shopify) ================= -->
    <Color x:Key="Color.Bg.App">#F1F1F1</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Subdued">#FAFAFA</Color>
    <Color x:Key="Color.Hover">#F1F1F1</Color>
    <Color x:Key="Color.Selected">#EBF5FF</Color>
    <Color x:Key="Color.Border">#E3E3E3</Color>
    <Color x:Key="Color.Border.Strong">#C9CCCF</Color>
    <Color x:Key="Color.Text">#1A1A1A</Color>
    <Color x:Key="Color.Text.Secondary">#616161</Color>
    <Color x:Key="Color.Text.Disabled">#A6A6A6</Color>
    <Color x:Key="Color.Action">#303030</Color>
    <Color x:Key="Color.Action.Hover">#1A1A1A</Color>
    <Color x:Key="Color.OnAction">#FFFFFF</Color>
    <Color x:Key="Color.Accent">#2C6ECB</Color>
    <Color x:Key="Color.Accent.Hover">#235BA8</Color>
    <Color x:Key="Color.Success">#007F5F</Color>
    <Color x:Key="Color.Success.Bg">#E7F5EF</Color>
    <Color x:Key="Color.Warning">#B98900</Color>
    <Color x:Key="Color.Warning.Bg">#FFF3D6</Color>
    <Color x:Key="Color.Critical">#D72C0D</Color>
    <Color x:Key="Color.Critical.Bg">#FDECEA</Color>
    <Color x:Key="Color.Pressed">#E3E3E3</Color>
    <Color x:Key="Color.Action.Pressed">#000000</Color>
    <Color x:Key="Color.Accent.Pressed">#1B4A8A</Color>
    <Color x:Key="Color.Overlay">#99000000</Color>
    <Color x:Key="Color.Sombra">#000000</Color>
    <Color x:Key="Color.OnColor">#FFFFFF</Color>

    <!-- ================= BRUSHES ================= -->
    <SolidColorBrush x:Key="Brush.Bg.App" Color="{StaticResource Color.Bg.App}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface.Subdued" Color="{StaticResource Color.Surface.Subdued}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Action" Color="{StaticResource Color.Action}" />
    <SolidColorBrush x:Key="Brush.Action.Hover" Color="{StaticResource Color.Action.Hover}" />
    <SolidColorBrush x:Key="Brush.OnAction" Color="{StaticResource Color.OnAction}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Success.Bg" Color="{StaticResource Color.Success.Bg}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Warning.Bg" Color="{StaticResource Color.Warning.Bg}" />
    <SolidColorBrush x:Key="Brush.Critical" Color="{StaticResource Color.Critical}" />
    <SolidColorBrush x:Key="Brush.Critical.Bg" Color="{StaticResource Color.Critical.Bg}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}" />
    <SolidColorBrush x:Key="Brush.Action.Pressed" Color="{StaticResource Color.Action.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
    <!-- Texto/íconos sobre fondos de color (avatares, botones oscuros). -->
    <SolidColorBrush x:Key="Brush.OnColor" Color="{StaticResource Color.OnColor}" />
    <!-- Impresos (etiquetas, ticket en pantalla): siempre tinta negra sobre papel blanco. -->
    <SolidColorBrush x:Key="Brush.Print.Ink" Color="#000000" />
    <SolidColorBrush x:Key="Brush.Print.Paper" Color="#FFFFFF" />

    <!-- ================= TIPOGRAFÍA ================= -->
    <!-- Inter incrustada (Fonts/). Segoe UI es el fallback si faltara algún glifo. -->
    <FontFamily x:Key="Font.Ui">pack://application:,,,/Fonts/#Inter</FontFamily>

    <!-- Escala tipográfica (cuerpo 15 para leer a distancia de brazo en pantalla táctil). -->
    <sys:Double x:Key="Font.Hero">64</sys:Double>
    <sys:Double x:Key="Font.Display">30</sys:Double>
    <sys:Double x:Key="Font.Title">22</sys:Double>
    <sys:Double x:Key="Font.Subtitle">17</sys:Double>
    <sys:Double x:Key="Font.Body">15</sys:Double>
    <sys:Double x:Key="Font.Small">13</sys:Double>
    <sys:Double x:Key="Font.Caption">12</sys:Double>
    <sys:Double x:Key="Font.Icon">20</sys:Double>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>

    <!-- ================= MEDIDAS ================= -->
    <CornerRadius x:Key="Radius">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
    <!-- Objetivos táctiles (dedo): mínimo 48, cómodo 56, grande 64 para acciones principales. -->
    <sys:Double x:Key="TouchTarget.Min">48</sys:Double>
    <sys:Double x:Key="TouchTarget.Comodo">56</sys:Double>
    <sys:Double x:Key="TouchTarget.Grande">64</sys:Double>
    <sys:Double x:Key="TouchTarget.Cobrar">64</sys:Double>
    <!-- Separación mínima entre objetivos táctiles contiguos. -->
    <sys:Double x:Key="Espacio.Tactil">8</sys:Double>
    <!-- Alto de fila de tabla cómodo para tocar. -->
    <sys:Double x:Key="Tabla.AltoFila">52</sys:Double>
    <GridLength x:Key="Espacio.Tactil.Col">8</GridLength>
    <Thickness x:Key="Margen.Tactil.H">8,0,8,0</Thickness>

</ResourceDictionary>
