<UserControl x:Class="Usashopp.Pos.Wpf.Features.Proveedores.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Usashopp.Pos.Wpf.Features.Proveedores"
             d:DataContext="{d:DesignInstance p:ProveedoresViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource TextBox.Base}" MaxWidth="420" HorizontalAlignment="Left"
                     Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding CargarCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Eliminar" Style="{StaticResource Button.Secondary}"
                    Command="{Binding DesactivarCommand}" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="Editar" Style="{StaticResource Button.Secondary}"
                    Command="{Binding EditarCommand}" Margin="0,0,10,0" />
            <Button Grid.Column="3" Content="Nuevo proveedor" Style="{StaticResource Button.Primary}"
                    Command="{Binding NuevoCommand}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Seleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42"
                      Background="{StaticResource Brush.Surface}" RowBackground="{StaticResource Brush.Surface}"
                      AlternatingRowBackground="{StaticResource Brush.Surface.Subdued}"
                      HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                      FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditarCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" />
                    <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" Width="*" />
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
