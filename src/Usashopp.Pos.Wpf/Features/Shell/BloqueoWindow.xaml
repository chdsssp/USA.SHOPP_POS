<Window x:Class="Usashopp.Pos.Wpf.Features.Shell.BloqueoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Usashopp.Pos.Wpf.Common.Controles"
        Title="Caja bloqueada" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <!-- Bloqueo manual de la caja (no automático, por decisión del Lote 4). -->
    <Grid>
        <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" Width="420">
            <StackPanel>
                <TextBlock Text="🔒" FontSize="{StaticResource Font.Display}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Mensaje}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,4" />
                <TextBlock Text="Desbloquea con tu PIN o el de un encargado." Foreground="{StaticResource Brush.Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0,0,0,14" />

                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                    <RadioButton GroupName="Modo" Content="PIN" Style="{StaticResource Segmento}" IsChecked="{Binding UsarPin}" />
                    <RadioButton GroupName="Modo" Content="Contraseña" Style="{StaticResource Segmento}" IsChecked="{Binding UsarContrasena}" />
                </WrapPanel>

                <ctl:PinPad x:Name="Pad" Pin="{Binding Pin, Mode=TwoWay}" Completado="OnPin"
                            Visibility="{Binding UsarPin, Converter={StaticResource BoolToVis}}" />

                <StackPanel Visibility="{Binding UsarContrasena, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Usuario" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Contraseña" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,4" />
                    <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="8"
                            Background="{StaticResource Brush.Surface.Subdued}">
                        <PasswordBox x:Name="Contrasena" MinHeight="{StaticResource TouchTarget.Min}" Padding="12,8"
                                     VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" />
                    </Border>
                    <Button Content="Desbloquear" Style="{StaticResource Button.Primary}" Margin="0,14,0,0"
                            MinHeight="{StaticResource TouchTarget.Comodo}" Click="OnDesbloquear" />
                </StackPanel>

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" Margin="0,12,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
