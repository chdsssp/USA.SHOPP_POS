<Window x:Class="Usashopp.Pos.Wpf.Features.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Usashopp.Pos.Wpf.Features.Shell"
        xmlns:pos="clr-namespace:Usashopp.Pos.Wpf.Features.Pos"
        xmlns:inv="clr-namespace:Usashopp.Pos.Wpf.Features.Inventario"
        xmlns:cat="clr-namespace:Usashopp.Pos.Wpf.Features.Categorias"
        xmlns:ventas="clr-namespace:Usashopp.Pos.Wpf.Features.Ventas"
        xmlns:cli="clr-namespace:Usashopp.Pos.Wpf.Features.Clientes"
        xmlns:prov="clr-namespace:Usashopp.Pos.Wpf.Features.Proveedores"
        xmlns:co="clr-namespace:Usashopp.Pos.Wpf.Features.Compras"
        xmlns:ap="clr-namespace:Usashopp.Pos.Wpf.Features.Apartados"
        xmlns:rep="clr-namespace:Usashopp.Pos.Wpf.Features.Reportes"
        xmlns:cortes="clr-namespace:Usashopp.Pos.Wpf.Features.Cortes"
        xmlns:et="clr-namespace:Usashopp.Pos.Wpf.Features.Etiquetas"
        xmlns:cfg="clr-namespace:Usashopp.Pos.Wpf.Features.Configuracion"
        xmlns:us="clr-namespace:Usashopp.Pos.Wpf.Features.Usuarios"
        xmlns:roles="clr-namespace:Usashopp.Pos.Wpf.Features.Roles"
        xmlns:aud="clr-namespace:Usashopp.Pos.Wpf.Features.Auditoria"
        xmlns:promo="clr-namespace:Usashopp.Pos.Wpf.Features.Promociones"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance shell:ShellViewModel}"
        Title="USASHOPP POS" Height="820" Width="1280" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">

    <Window.Resources>
        <!-- Mapeo ViewModel -> View -->
        <DataTemplate DataType="{x:Type pos:PosViewModel}">
            <pos:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inv:InventarioViewModel}">
            <inv:InventarioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type et:EtiquetasViewModel}">
            <et:EtiquetasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type cat:CategoriasViewModel}">
            <cat:CategoriasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ventas:VentasViewModel}">
            <ventas:VentasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type cli:ClientesViewModel}">
            <cli:ClientesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type prov:ProveedoresViewModel}">
            <prov:ProveedoresView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type co:ComprasViewModel}">
            <co:ComprasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ap:ApartadosViewModel}">
            <ap:ApartadosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type rep:ReportesViewModel}">
            <rep:ReportesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type cortes:HistorialCortesViewModel}">
            <cortes:HistorialCortesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type cfg:ConfiguracionViewModel}">
            <cfg:ConfiguracionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type us:UsuariosViewModel}">
            <us:UsuariosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type roles:RolesViewModel}">
            <roles:RolesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type promo:PromocionesViewModel}">
            <promo:PromocionesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type aud:AuditoriaViewModel}">
            <aud:AuditoriaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type shell:PlaceholderViewModel}">
            <shell:PlaceholderView />
        </DataTemplate>

        <!-- Estilo de los elementos de navegación -->
        <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="{StaticResource TouchTarget.Comodo}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Activo}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding AnchoMenu}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== NAVEGACIÓN LATERAL ===================== -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Marca -->
                <Border DockPanel.Dock="Top" Height="56" Padding="12,0"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- ☰ colapsa/expande el menú (modo cajero = solo íconos) -->
                        <Button Content="☰" Style="{StaticResource Button.Icon}" ToolTip="Mostrar u ocultar el menú"
                                Command="{Binding AlternarMenuCommand}" />
                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding MenuExpandido, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding NombreTienda}" FontWeight="SemiBold" FontSize="{StaticResource Font.Body}" />
                            <TextBlock Text="Punto de venta" FontSize="{StaticResource Font.Caption}"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Menú -->
                <ItemsControl ItemsSource="{Binding Menu}" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavItem}"
                                    Command="{Binding DataContext.NavegarCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding IconData}" Width="22" Height="22" Stretch="Uniform"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Titulo}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.MenuExpandido, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ===================== ÁREA DERECHA ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Aviso de respaldos (no bloquea) -->
            <Border Grid.Row="1" Background="{StaticResource Brush.Warning.Bg}" Padding="20,6"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                    Visibility="{Binding AvisoRespaldo, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Button.Icon}" ToolTip="Ocultar"
                            Command="{Binding OcultarAvisoCommand}" />
                    <TextBlock Text="{Binding AvisoRespaldo}" Foreground="{StaticResource Brush.Warning}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- Caja abierta -->
                        <Border Background="{StaticResource Brush.Success.Bg}" CornerRadius="6" Padding="12,6"
                                VerticalAlignment="Center"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CajaTexto}" Foreground="{StaticResource Brush.Success}"
                                           FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Caja cerrada -->
                        <Border Background="{StaticResource Brush.Bg.App}" CornerRadius="6" Padding="12,6"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" VerticalAlignment="Center"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Text.Disabled}" VerticalAlignment="Center" />
                                <TextBlock Text="Caja cerrada" Foreground="{StaticResource Brush.Text.Secondary}"
                                           FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Movimiento de caja (con caja abierta) -->
                        <Button Content="Movimiento de caja" Style="{StaticResource Button.Subtle}"
                                MinHeight="{StaticResource TouchTarget.Min}" Padding="12,4" Margin="10,0,0,0" FontSize="{StaticResource Font.Small}"
                                Command="{Binding MovimientoCajaCommand}"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVis}}" />
                        <!-- Corte de caja (solo con caja abierta) -->
                        <Button Content="Corte de caja" Style="{StaticResource Button.Subtle}"
                                MinHeight="{StaticResource TouchTarget.Min}" Padding="12,4" Margin="10,0,0,0" FontSize="{StaticResource Font.Small}"
                                Command="{Binding CorteCajaCommand}"
                                Visibility="{Binding MostrarCorte, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Usuario}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                        <Border Width="30" Height="30" CornerRadius="15" Margin="10,0,0,0"
                                Background="{StaticResource Brush.Selected}">
                            <TextBlock Text="{Binding Iniciales}" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"
                                       FontSize="{StaticResource Font.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Content="Mi cuenta" Style="{StaticResource Button.Subtle}" MinHeight="{StaticResource TouchTarget.Min}"
                                Padding="12,4" Margin="10,0,0,0" FontSize="{StaticResource Font.Small}" Command="{Binding MiCuentaCommand}" />
                        <Button Content="Bloquear" Style="{StaticResource Button.Subtle}" MinHeight="{StaticResource TouchTarget.Min}"
                                Padding="12,4" Margin="10,0,0,0" FontSize="{StaticResource Font.Small}" Command="{Binding BloquearCommand}"
                                ToolTip="Bloquear la caja (se desbloquea con PIN)" />
                        <Button Content="Cambiar cajero" ToolTip="Cerrar sesión y entrar con otro usuario o PIN (el carrito queda guardado)" Style="{StaticResource Button.Subtle}" MinHeight="{StaticResource TouchTarget.Min}"
                                Padding="12,4" Margin="10,0,0,0" FontSize="{StaticResource Font.Small}" Command="{Binding CerrarSesionCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenido activo -->
            <ContentControl Grid.Row="2" Content="{Binding ContenidoActual}" />
        </Grid>
    </Grid>
</Window>
