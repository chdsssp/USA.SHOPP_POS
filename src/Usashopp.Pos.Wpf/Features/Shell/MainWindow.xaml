<Window x:Class="Usashopp.Pos.Wpf.Features.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Usashopp.Pos.Wpf.Features.Shell"
        xmlns:pos="clr-namespace:Usashopp.Pos.Wpf.Features.Pos"
        xmlns:inv="clr-namespace:Usashopp.Pos.Wpf.Features.Inventario"
        xmlns:ventas="clr-namespace:Usashopp.Pos.Wpf.Features.Ventas"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance shell:ShellViewModel}"
        Title="USASHOPP POS" Height="820" Width="1280" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">

    <Window.Resources>
        <!-- Mapeo ViewModel -> View -->
        <DataTemplate DataType="{x:Type pos:PosViewModel}">
            <pos:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inv:InventarioViewModel}">
            <inv:InventarioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ventas:VentasViewModel}">
            <ventas:VentasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type shell:PlaceholderViewModel}">
            <shell:PlaceholderView />
        </DataTemplate>

        <!-- Estilo de los elementos de navegación -->
        <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="12,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Activo}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== NAVEGACIÓN LATERAL ===================== -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Marca -->
                <Border DockPanel.Dock="Top" Height="56" Padding="16,0"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Brush.Action}">
                            <TextBlock Text="US" Foreground="White" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NombreTienda}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Punto de venta" FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Menú -->
                <ItemsControl ItemsSource="{Binding Menu}" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavItem}"
                                    Command="{Binding DataContext.NavegarCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding IconData}" Width="18" Height="18" Stretch="Uniform"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Titulo}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ===================== ÁREA DERECHA ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- Caja abierta -->
                        <Border Background="{StaticResource Brush.Success.Bg}" CornerRadius="999" Padding="12,6"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CajaTexto}" Foreground="{StaticResource Brush.Success}"
                                           FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Caja cerrada -->
                        <Border Background="{StaticResource Brush.Bg.App}" CornerRadius="999" Padding="12,6"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Text.Disabled}" VerticalAlignment="Center" />
                                <TextBlock Text="Caja cerrada" Foreground="{StaticResource Brush.Text.Secondary}"
                                           FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Corte de caja (solo con caja abierta) -->
                        <Button Content="Corte de caja" Style="{StaticResource Button.Subtle}"
                                MinHeight="34" Padding="12,4" Margin="10,0,0,0" FontSize="12.5"
                                Command="{Binding CorteCajaCommand}"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Usuario}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                        <Border Width="30" Height="30" CornerRadius="15" Margin="10,0,0,0"
                                Background="{StaticResource Brush.Selected}">
                            <TextBlock Text="TU" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenido activo -->
            <ContentControl Grid.Row="1" Content="{Binding ContenidoActual}" />
        </Grid>
    </Grid>
</Window>
