<UserControl x:Class="Usashopp.Pos.Wpf.Features.Cortes.HistorialCortesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Usashopp.Pos.Wpf.Features.Cortes"
             d:DataContext="{d:DesignInstance c:HistorialCortesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Historial de cortes de caja" VerticalAlignment="Center"
                       FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" />
            <Button Content="Actualizar" Style="{StaticResource Button.Secondary}"
                    HorizontalAlignment="Right" Command="{Binding CargarCommand}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Cortes}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42"
                          Background="{StaticResource Brush.Surface}"
                          HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Apertura" Binding="{Binding FechaApertura, StringFormat=dd/MM/yyyy HH:mm}" Width="*" />
                        <DataGridTextColumn Header="Cierre" Binding="{Binding FechaCierre, StringFormat=dd/MM/yyyy HH:mm}" Width="*" />
                        <DataGridTextColumn Header="Ventas" Binding="{Binding NumVentas}" Width="80" />
                        <DataGridTextColumn Header="Total ventas" Binding="{Binding TotalVentas, StringFormat=C2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Esperado" Binding="{Binding EfectivoEsperado, StringFormat=C2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Contado" Binding="{Binding MontoContado, StringFormat=C2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Diferencia" Binding="{Binding Diferencia, StringFormat=C2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Aún no hay cortes de caja registrados." VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Cortes.Count, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
