<UserControl x:Class="Usashopp.Pos.Wpf.Features.Etiquetas.EtiquetaHojaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:et="clr-namespace:Usashopp.Pos.Wpf.Features.Etiquetas"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance et:EtiquetaDatos}"
             Width="384" Height="576" Background="White">
    <!-- Hoja 4×6" (384×576 px) con 4 etiquetas iguales (2×2) para recortar a mano.
         Cada etiqueta se escala a la mitad; el pequeño margen deja una guía de corte. -->
    <UniformGrid Rows="2" Columns="2" Background="White">
        <Viewbox Stretch="Uniform" Margin="3"><et:EtiquetaControl /></Viewbox>
        <Viewbox Stretch="Uniform" Margin="3"><et:EtiquetaControl /></Viewbox>
        <Viewbox Stretch="Uniform" Margin="3"><et:EtiquetaControl /></Viewbox>
        <Viewbox Stretch="Uniform" Margin="3"><et:EtiquetaControl /></Viewbox>
    </UniformGrid>
</UserControl>
