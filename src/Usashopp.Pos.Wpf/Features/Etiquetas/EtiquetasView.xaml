<UserControl x:Class="Usashopp.Pos.Wpf.Features.Etiquetas.EtiquetasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:et="clr-namespace:Usashopp.Pos.Wpf.Features.Etiquetas"
             d:DataContext="{d:DesignInstance et:EtiquetasViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Buscador -->
        <TextBox Grid.Row="0" Grid.Column="0" Style="{StaticResource TextBox.Base}"
                 Tag="Buscar por nombre, marca, talla o color…"
                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Listado de productos -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Productos}" SelectedItem="{Binding Seleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40"
                          Background="{StaticResource Brush.Surface}"
                          HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*" />
                        <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="110" />
                        <DataGridTextColumn Header="Talla" Binding="{Binding Talla}" Width="70" />
                        <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="90" />
                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Sin productos que coincidan." VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Productos.Count, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>

        <!-- Vista previa de la etiqueta -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Vista previa de la etiqueta" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                <!-- Sin selección -->
                <TextBlock Grid.Row="1" Text="Selecciona un producto para ver su etiqueta." VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Preview, Converter={StaticResource NullToCollapsed}, ConverterParameter=inv}" />

                <!-- Etiqueta -->
                <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Preview, Converter={StaticResource NullToCollapsed}}">
                    <Viewbox Stretch="Uniform" MaxHeight="520" MaxWidth="340">
                        <et:EtiquetaHojaControl DataContext="{Binding Preview}" />
                    </Viewbox>
                </Border>

                <Button Grid.Row="2" Content="Imprimir etiqueta" Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Stretch" Margin="0,12,0,0" Command="{Binding ImprimirCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
