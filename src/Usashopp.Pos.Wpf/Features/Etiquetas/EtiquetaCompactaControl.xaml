<UserControl x:Class="Usashopp.Pos.Wpf.Features.Etiquetas.EtiquetaCompactaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:et="clr-namespace:Usashopp.Pos.Wpf.Features.Etiquetas"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance et:EtiquetaDatos}"
             Width="384" Height="192" Background="White">
    <!-- Etiqueta apaisada (2:1) para papel ancho y corto (4×2", 80×50 mm, 2×1"…). -->
    <Border BorderBrush="Black" BorderThickness="2" Background="White">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado: logo o nombre del negocio -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Image Source="{Binding LogoAbsoluto}" Stretch="Uniform" MaxHeight="34" HorizontalAlignment="Center"
                       Visibility="{Binding TieneLogo, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding NombreNegocio}" Foreground="Black" FontWeight="Bold" FontSize="16"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding TieneLogo, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>

            <!-- Talla + datos -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,2,0" Padding="0,0,10,0" MinWidth="76">
                    <TextBlock Text="{Binding Talla}" Foreground="Black" FontWeight="Bold" FontSize="48"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Nombre}" Foreground="Black" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Marca}" Foreground="Black" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Color}" Foreground="Black" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Código de barras -->
            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                <et:BarcodeControl Codigo="{Binding Codigo}" Height="34"
                                   Visibility="{Binding TieneCodigo, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Codigo}" Foreground="Black" FontSize="11" TextAlignment="Center"
                           Margin="0,2,0,0" FontFamily="Consolas"
                           Visibility="{Binding TieneCodigo, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="Sin código de barras" Foreground="Black" FontSize="11" TextAlignment="Center"
                           Margin="0,6,0,6"
                           Visibility="{Binding TieneCodigo, Converter={StaticResource InverseBoolToVis}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
