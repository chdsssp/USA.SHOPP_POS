<UserControl x:Class="Usashopp.Pos.Wpf.Features.Ventas.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Usashopp.Pos.Wpf.Features.Ventas"
             d:DataContext="{d:DesignInstance v:VentasViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
            <TextBlock Text="Desde" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding Desde}" MinHeight="40" VerticalContentAlignment="Center" />
            <TextBlock Text="Hasta" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="16,0,8,0" />
            <DatePicker SelectedDate="{Binding Hasta}" MinHeight="40" VerticalContentAlignment="Center" />
            <Button Content="Buscar" Style="{StaticResource Button.Secondary}" Command="{Binding CargarCommand}" Margin="16,0,0,0" />
        </StackPanel>

        <!-- Tabla de ventas -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Ventas}" SelectedItem="{Binding Seleccionada}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42"
                      Background="{StaticResource Brush.Surface}"

                      HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                      FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="120" />
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="*" />
                    <DataGridTextColumn Header="Artículos" Binding="{Binding Articulos}" Width="90" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Detalle -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <TextBlock Text="Selecciona una venta para ver su detalle." VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                           Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Detalle, Converter={StaticResource NullToCollapsed}, ConverterParameter=inv}" />

                <Grid Visibility="{Binding Detalle, Converter={StaticResource NullToCollapsed}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,14">
                        <TextBlock Text="{Binding Detalle.Folio}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detalle.Fecha, StringFormat='dddd dd MMMM yyyy, HH:mm'}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" Margin="0,2,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Detalle.Lineas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12">
                                                    <Run Text="{Binding Cantidad, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding PrecioUnitario, StringFormat=C2, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Importe, StringFormat=C2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Background="{StaticResource Brush.Surface.Subdued}">
                        <StackPanel Margin="16,12">
                            <Border Background="{StaticResource Brush.Surface}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding Detalle.Notas, Converter={StaticResource NullToCollapsed}}">
                                <StackPanel>
                                    <TextBlock Text="Notas" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11.5" />
                                    <TextBlock Text="{Binding Detalle.Notas}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Subtotal" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding Detalle.Subtotal, StringFormat=C2}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource Brush.Text.Secondary}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Total" FontWeight="Bold" FontSize="18" />
                                <TextBlock Text="{Binding Detalle.Total, StringFormat=C2}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" />
                            </Grid>
                            <Button Content="Vista previa del ticket" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding VistaPreviaCommand}" Margin="0,12,0,0" />
                            <Button Content="Reimprimir ticket" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding ReimprimirCommand}" Margin="0,8,0,0" />
                            <Button Content="Cancelar venta" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding CancelarVentaCommand}" Margin="0,8,0,0"
                                    Foreground="{StaticResource Brush.Critical}"
                                    Visibility="{Binding PuedeCancelar, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
