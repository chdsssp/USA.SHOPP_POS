<Window x:Class="Usashopp.Pos.Wpf.Features.Compras.CompraEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:co="clr-namespace:Usashopp.Pos.Wpf.Features.Compras"
        xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance co:CompraEditorViewModel}"
        Title="Nueva compra" Height="640" Width="720" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nueva compra" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Proveedor + agregar línea -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Proveedor" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorSeleccionado}"
                          DisplayMemberPath="Nombre" MinHeight="40" VerticalContentAlignment="Center" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Producto" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Cantidad" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Costo unitario" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />

                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Variantes}" SelectedItem="{Binding VarianteSeleccionada}"
                              DisplayMemberPath="Descripcion" MinHeight="40" VerticalContentAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource TextBox.Base}" common:InputHelpers.SoloNumeros="True"
                             Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource TextBox.Base}" common:InputHelpers.SoloNumeros="True"
                             Text="{Binding Costo, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" TextAlignment="Center" />
                    <Button Grid.Row="1" Grid.Column="6" Content="Agregar" Style="{StaticResource Button.Secondary}"
                            Command="{Binding AgregarLineaCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Líneas -->
        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeight="40" Background="{StaticResource Brush.Surface}"

                      HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                      FontFamily="{StaticResource Font.Ui}" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*" />
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90" />
                    <DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat=C2}" Width="110" />
                    <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C2}" Width="120" />
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" ToolTip="Quitar" Foreground="{StaticResource Brush.Critical}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.QuitarLineaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Total + error -->
        <Grid Grid.Row="3" Margin="2,12,2,0">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Total:" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Total, StringFormat=C2}" FontWeight="Bold" FontSize="18" />
            </StackPanel>
        </Grid>

        <!-- Acciones -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}" Command="{Binding CancelarCommand}"
                    Margin="0,0,10,0" MinWidth="120" />
            <Button Content="Registrar compra" Style="{StaticResource Button.Primary}" Command="{Binding GuardarCommand}"
                    IsEnabled="{Binding Guardando, Converter={StaticResource InverseBool}}" MinWidth="170" />
        </StackPanel>
    </Grid>
</Window>
