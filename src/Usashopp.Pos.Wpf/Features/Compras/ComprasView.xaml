<UserControl x:Class="Usashopp.Pos.Wpf.Features.Compras.ComprasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:co="clr-namespace:Usashopp.Pos.Wpf.Features.Compras"
             d:DataContext="{d:DesignInstance co:ComprasViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Content="Nueva compra" Style="{StaticResource Button.Primary}"
                HorizontalAlignment="Left" Command="{Binding NuevaCompraCommand}" />

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Compras}" SelectedItem="{Binding Seleccionada}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42"
                      Background="{StaticResource Brush.Surface}"

                      HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                      FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="120" />
                    <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*" />
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Detalle -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <TextBlock Text="Selecciona una compra para ver su detalle." VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                           Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Detalle, Converter={StaticResource NullToCollapsed}, ConverterParameter=inv}" />

                <Grid Visibility="{Binding Detalle, Converter={StaticResource NullToCollapsed}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="16,14">
                        <TextBlock Text="{Binding Detalle.Folio}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detalle.Proveedor}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Detalle.Lineas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12">
                                                    <Run Text="{Binding Cantidad, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding CostoUnitario, StringFormat=C2, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Importe, StringFormat=C2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Background="{StaticResource Brush.Surface.Subdued}">
                        <Grid Margin="16,14">
                            <TextBlock Text="Total" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text="{Binding Detalle.Total, StringFormat=C2}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
