<UserControl x:Class="Usashopp.Pos.Wpf.Features.Auditoria.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Usashopp.Pos.Wpf.Features.Auditoria"
             xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
             d:DataContext="{d:DesignInstance a:AuditoriaViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bitácora de auditoría" VerticalAlignment="Center"
                   FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" />

        <!-- Filtros -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Desde" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding Desde}" MinHeight="40" VerticalContentAlignment="Center" />
            <TextBlock Text="Hasta" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="16,0,8,0" />
            <DatePicker SelectedDate="{Binding Hasta}" MinHeight="40" VerticalContentAlignment="Center" />
            <TextBlock Text="Buscar" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="16,0,8,0" />
            <TextBox Style="{StaticResource TextBox.Base}" Width="240" VerticalContentAlignment="Center"
                     Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Actualizar" Style="{StaticResource Button.Secondary}" Command="{Binding CargarCommand}" Margin="16,0,0,0" />
            <Button Content="Limpiar" Style="{StaticResource Button.Secondary}" Command="{Binding LimpiarCommand}" Margin="10,0,0,0" />
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Registros}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40"
                          Background="{StaticResource Brush.Surface}"
                          HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="180" />
                        <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="220" />
                        <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No hay registros para el filtro actual." VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Registros.Count, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
