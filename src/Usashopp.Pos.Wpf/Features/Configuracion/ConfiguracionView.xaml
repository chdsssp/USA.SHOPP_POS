<UserControl x:Class="Usashopp.Pos.Wpf.Features.Configuracion.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cfg="clr-namespace:Usashopp.Pos.Wpf.Features.Configuracion"
             xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
             d:DataContext="{d:DesignInstance cfg:ConfiguracionViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="620" HorizontalAlignment="Left">

            <!-- Datos de la tienda -->
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Datos de la tienda" FontWeight="SemiBold" FontSize="{StaticResource Font.Body}" Margin="0,0,0,12" />

                    <TextBlock Text="Nombre" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding NombreTienda, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Teléfono" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Telefono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RFC" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Rfc}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Dirección" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Direccion}" />

                    <TextBlock Text="Mensaje al pie del ticket" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding MensajePieTicket}" />

                    <TextBlock Text="Logo del ticket" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="88" Height="64" CornerRadius="8" Background="{StaticResource Brush.Surface.Subdued}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="Sin logo" FontSize="{StaticResource Font.Caption}" Foreground="{StaticResource Brush.Text.Disabled}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding TieneLogo, Converter={StaticResource InverseBoolToVis}}" />
                                <Image Source="{Binding LogoAbsoluto}" Stretch="Uniform"
                                       Visibility="{Binding TieneLogo, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" Orientation="Horizontal">
                            <Button Content="Elegir logo…" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding ElegirLogoCommand}" Margin="0,0,8,0" />
                            <Button Content="Quitar" Style="{StaticResource Button.Subtle}"
                                    Command="{Binding QuitarLogoCommand}"
                                    Visibility="{Binding TieneLogo, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Impuestos / operación -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Impuestos y operación" FontWeight="SemiBold" FontSize="{StaticResource Font.Body}" Margin="0,0,0,12" />
                    <TextBlock Text="Tasa de impuesto (ej. 0.16 = 16%)" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" MaxWidth="200" HorizontalAlignment="Left"
                             common:InputHelpers.SoloNumeros="True"
                             Text="{Binding TasaImpuesto, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                    <CheckBox Content="Los precios ya incluyen impuesto" IsChecked="{Binding ImpuestoIncluido}" Margin="0,12,0,0" />
                    <CheckBox Content="Permitir vender con stock en negativo" IsChecked="{Binding PermitirStockNegativo}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Impresora de tickets (ESC/POS) -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Impresora de tickets" FontWeight="SemiBold" FontSize="{StaticResource Font.Body}" Margin="0,0,0,4" />
                    <TextBlock Text="Impresora térmica ESC/POS (papel 80 mm). Déjala vacía para no imprimir (solo vista previa)."
                               Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <TextBlock Text="Impresora de Windows" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Impresoras}" Text="{Binding ImpresoraTicket, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" MinHeight="{StaticResource TouchTarget.Min}" VerticalContentAlignment="Center" HorizontalAlignment="Left" MinWidth="360" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Guardar y probar impresión" Style="{StaticResource Button.Secondary}"
                                Command="{Binding ImprimirPruebaCommand}" />
                    </StackPanel>
                    <TextBlock Text="El cajón de dinero se abre por esta misma impresora al cobrar en efectivo."
                               Foreground="{StaticResource Brush.Text.Disabled}" FontSize="{StaticResource Font.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="Impresora de etiquetas (4×6&quot;)" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,16,0,4" />
                    <ComboBox ItemsSource="{Binding Impresoras}" Text="{Binding ImpresoraEtiquetas, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" MinHeight="{StaticResource TouchTarget.Min}" VerticalContentAlignment="Center" HorizontalAlignment="Left" MinWidth="360" />
                    <TextBlock Text="Se usa en el módulo de Etiquetas para imprimir etiquetas de producto con código de barras."
                               Foreground="{StaticResource Brush.Text.Disabled}" FontSize="{StaticResource Font.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button Content="Guardar configuración" Style="{StaticResource Button.Primary}"
                    HorizontalAlignment="Left" Command="{Binding GuardarCommand}" Margin="0,14,0,0" />

            <!-- Este equipo (se guarda al momento en terminal.json, no en la BD) -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Este equipo" FontWeight="SemiBold" FontSize="{StaticResource Font.Subtitle}" />
                    <TextBlock Text="Preferencias solo de esta caja. Se aplican y guardan al momento."
                               Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,12" TextWrapping="Wrap" />

                    <TextBlock Text="Tamaño de la interfaz" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <RadioButton GroupName="Escala" Content="100 %" Style="{StaticResource Segmento}"
                                     IsChecked="{Binding Terminal.EscalaUi, Converter={StaticResource IgualA}, ConverterParameter=1}" />
                        <RadioButton GroupName="Escala" Content="115 %" Style="{StaticResource Segmento}"
                                     IsChecked="{Binding Terminal.EscalaUi, Converter={StaticResource IgualA}, ConverterParameter=1.15}" />
                        <RadioButton GroupName="Escala" Content="125 %" Style="{StaticResource Segmento}"
                                     IsChecked="{Binding Terminal.EscalaUi, Converter={StaticResource IgualA}, ConverterParameter=1.25}" />
                        <RadioButton GroupName="Escala" Content="140 %" Style="{StaticResource Segmento}"
                                     IsChecked="{Binding Terminal.EscalaUi, Converter={StaticResource IgualA}, ConverterParameter=1.4}" />
                    </WrapPanel>

                    <TextBlock Text="Teclado en pantalla" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,10,0,6" />
                    <WrapPanel>
                        <RadioButton GroupName="Teclado" Content="Solo al tocar" Style="{StaticResource Segmento}"
                                     IsChecked="{Binding Terminal.Teclado, Converter={StaticResource IgualA}, ConverterParameter=SoloTactil}" />
                        <RadioButton GroupName="Teclado" Content="Siempre" Style="{StaticResource Segmento}"
                                     IsChecked="{Binding Terminal.Teclado, Converter={StaticResource IgualA}, ConverterParameter=Siempre}" />
                        <RadioButton GroupName="Teclado" Content="Nunca" Style="{StaticResource Segmento}"
                                     IsChecked="{Binding Terminal.Teclado, Converter={StaticResource IgualA}, ConverterParameter=Nunca}" />
                    </WrapPanel>

                    <CheckBox Content="Entrar directo al punto de venta en pantalla completa (modo cajero)"
                              IsChecked="{Binding Terminal.PantallaCompletaAlIniciar}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Respaldos -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Respaldos" FontWeight="SemiBold" FontSize="{StaticResource Font.Subtitle}" />
                    <TextBlock Text="Cada respaldo se copia en línea y se verifica. Se crean solos al cerrar caja, cada pocas horas y antes de actualizar la base."
                               Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Content="Crear respaldo ahora" Style="{StaticResource Button.Primary}"
                                Command="{Binding CrearRespaldoCommand}" Margin="0,0,10,10" />
                        <Button Content="Restaurar el seleccionado" Style="{StaticResource Button.Secondary}"
                                Command="{Binding RestaurarSeleccionadoCommand}" Margin="0,0,10,10" />
                        <Button Content="Restaurar desde archivo…" Style="{StaticResource Button.Secondary}"
                                Command="{Binding RestaurarRespaldoCommand}" Margin="0,0,10,10" />
                    </WrapPanel>

                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}"
                            MaxHeight="320" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Respaldos}" SelectedItem="{Binding RespaldoSeleccionado}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" SelectionMode="Single"
                                  HorizontalGridLinesBrush="{StaticResource Brush.Border}" Background="{StaticResource Brush.Surface}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                                <DataGridTextColumn Header="Origen" Binding="{Binding OrigenTexto}" Width="*" />
                                <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanoTexto}" Width="100" />
                                <DataGridTextColumn Header="Verificación" Binding="{Binding VerificadoTexto}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Text="Respaldo externo (USB o disco)" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="Si la computadora falla, una copia en otro dispositivo es lo único que salva la información. Cada respaldo se copia también aquí."
                               Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Terminal.CarpetaRespaldoExterno, TargetNullValue='(sin carpeta)'}" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding EstadoExterno}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Content="Elegir carpeta…" Style="{StaticResource Button.Secondary}"
                                Command="{Binding ElegirCarpetaExternaCommand}" Margin="0,0,10,0" />
                        <Button Content="Quitar" Style="{StaticResource Button.Subtle}"
                                Command="{Binding QuitarCarpetaExternaCommand}" />
                    </WrapPanel>
                    <TextBlock Text="Restaurar reemplaza toda la base actual y reinicia la app."
                               Foreground="{StaticResource Brush.Text.Disabled}" FontSize="{StaticResource Font.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
