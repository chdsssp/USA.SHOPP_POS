<UserControl x:Class="Usashopp.Pos.Wpf.Features.Configuracion.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cfg="clr-namespace:Usashopp.Pos.Wpf.Features.Configuracion"
             xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
             d:DataContext="{d:DesignInstance cfg:ConfiguracionViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="620" HorizontalAlignment="Left">

            <!-- Datos de la tienda -->
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Datos de la tienda" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

                    <TextBlock Text="Nombre" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding NombreTienda, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Teléfono" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Telefono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RFC" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Rfc}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Dirección" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Direccion}" />

                    <TextBlock Text="Mensaje al pie del ticket" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding MensajePieTicket}" />
                </StackPanel>
            </Border>

            <!-- Impuestos / operación -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Impuestos y operación" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock Text="Tasa de impuesto (ej. 0.16 = 16%)" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" MaxWidth="200" HorizontalAlignment="Left"
                             common:InputHelpers.SoloNumeros="True"
                             Text="{Binding TasaImpuesto, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                    <CheckBox Content="Los precios ya incluyen impuesto" IsChecked="{Binding ImpuestoIncluido}" Margin="0,12,0,0" />
                    <CheckBox Content="Permitir vender con stock en negativo" IsChecked="{Binding PermitirStockNegativo}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Button Content="Guardar configuración" Style="{StaticResource Button.Primary}"
                    HorizontalAlignment="Left" Command="{Binding GuardarCommand}" Margin="0,14,0,0" />

            <!-- Respaldos -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Respaldos" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Crea una copia de seguridad de la base de datos ahora mismo."
                               Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <Button Content="Crear respaldo ahora" Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Left" Command="{Binding CrearRespaldoCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
