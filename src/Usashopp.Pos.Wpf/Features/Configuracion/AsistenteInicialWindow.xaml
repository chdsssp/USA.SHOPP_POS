<Window x:Class="Usashopp.Pos.Wpf.Features.Configuracion.AsistenteInicialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cfg="clr-namespace:Usashopp.Pos.Wpf.Features.Configuracion"
        xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance cfg:AsistenteInicialViewModel}"
        Title="Configuración inicial" Height="680" Width="520" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="¡Bienvenido! Configura tu tienda" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" />
            <TextBlock Text="Estos datos aparecen en el ticket y en los documentos. Puedes cambiarlos luego en Configuración."
                       Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Nombre de la tienda" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding NombreTienda, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teléfono" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Telefono}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RFC" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Rfc}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Dirección" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,4" />
                <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Direccion}" />

                <TextBlock Text="Mensaje al pie del ticket" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,4" />
                <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding MensajePie}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tasa de impuesto (ej. 0.16)" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Style="{StaticResource TextBox.Base}" common:InputHelpers.SoloNumeros="True"
                             Text="{Binding TasaImpuesto, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Text="Prefijos de folio" FontWeight="SemiBold" Margin="0,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Venta" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding PrefijoVenta}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Apartado" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding PrefijoApartado}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Compra" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding PrefijoCompra}" />
                    </StackPanel>
                </Grid>

                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Cambiar contraseña de admin (opcional)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="Recomendado: cambia la contraseña por defecto." FontSize="11.5"
                                   Foreground="{StaticResource Brush.Text.Disabled}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Actual" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" FontSize="12" />
                                <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Brush.Surface.Subdued}">
                                    <PasswordBox x:Name="Actual" MinHeight="40" Padding="10,6" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nueva" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" FontSize="12" />
                                <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Brush.Surface.Subdued}">
                                    <PasswordBox x:Name="Nueva" MinHeight="40" Padding="10,6" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Confirmar" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" FontSize="12" />
                                <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Brush.Surface.Subdued}">
                                    <PasswordBox x:Name="Confirmar" MinHeight="40" Padding="10,6" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Omitir" Style="{StaticResource Button.Secondary}" Click="OnOmitir" Margin="0,0,10,0" MinWidth="110" />
            <Button Content="Guardar y continuar" Style="{StaticResource Button.Primary}" Click="OnGuardar" MinWidth="170"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InverseBool}}" />
        </StackPanel>
    </Grid>
</Window>
