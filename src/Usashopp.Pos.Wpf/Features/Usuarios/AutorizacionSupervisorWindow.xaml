<Window x:Class="Usashopp.Pos.Wpf.Features.Usuarios.AutorizacionSupervisorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
        xmlns:ctl="clr-namespace:Usashopp.Pos.Wpf.Common.Controles"
        xmlns:us="clr-namespace:Usashopp.Pos.Wpf.Features.Usuarios"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance us:AutorizacionSupervisorViewModel}"
        Title="Autorización de supervisor" SizeToContent="Height" Width="440" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" common:VentanaHelpers.Redimensionable="True" FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <StackPanel Margin="24">
        <TextBlock Text="Autorización de supervisor" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource Brush.Text.Secondary}"
                   FontSize="{StaticResource Font.Small}" TextWrapping="Wrap" Margin="0,2,0,12" />

        <WrapPanel Margin="0,0,0,8">
            <RadioButton GroupName="Modo" Content="Con PIN" Style="{StaticResource Segmento}" IsChecked="{Binding UsarPin}" />
            <RadioButton GroupName="Modo" Content="Usuario y contraseña" Style="{StaticResource Segmento}" IsChecked="{Binding UsarContrasena}" />
        </WrapPanel>

        <!-- PIN -->
        <ctl:PinPad x:Name="Pad" Pin="{Binding Pin, Mode=TwoWay}" Completado="OnPinCompletado"
                    Visibility="{Binding UsarPin, Converter={StaticResource BoolToVis}}" />

        <!-- Usuario y contraseña -->
        <StackPanel Visibility="{Binding UsarContrasena, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Usuario supervisor" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
            <TextBox x:Name="Login" Style="{StaticResource TextBox.Base}"
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Contraseña" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,14,0,4" />
            <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="{StaticResource Radius}"
                    Background="{StaticResource Brush.Surface.Subdued}">
                <PasswordBox x:Name="Contrasena" MinHeight="{StaticResource TouchTarget.Min}" Padding="12,8" VerticalContentAlignment="Center"
                             Background="Transparent" BorderThickness="0" FontSize="{StaticResource Font.Body}" KeyDown="OnContrasenaKeyDown" />
            </Border>
        </StackPanel>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource Espacio.Tactil.Col}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource Button.Secondary}" Click="OnCancelar"
                    MinHeight="{StaticResource TouchTarget.Comodo}" />
            <Button Grid.Column="2" Content="Autorizar" Style="{StaticResource Button.Primary}" Click="OnAutorizar"
                    MinHeight="{StaticResource TouchTarget.Comodo}"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InverseBool}}" />
        </Grid>
    </StackPanel>
</Window>
