<Window x:Class="Usashopp.Pos.Wpf.Features.Inventario.TomaFisicaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inv="clr-namespace:Usashopp.Pos.Wpf.Features.Inventario"
        xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance inv:TomaFisicaViewModel}"
        Title="Toma de inventario físico" Height="640" Width="760" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Toma de inventario físico" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" />
            <TextBlock Text="Captura la cantidad realmente contada. Al aplicar, se ajusta el stock de las variantes con diferencia."
                       Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,10" />
            <TextBox Style="{StaticResource TextBox.Base}" Width="360" HorizontalAlignment="Left"
                     Tag="Filtrar por producto, SKU o código…"
                     Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding CargarCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Lineas}"
                      AutoGenerateColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40"
                      Background="{StaticResource Brush.Surface}"
                      HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                      FontFamily="{StaticResource Font.Ui}" FontSize="13"
                      CanUserAddRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" IsReadOnly="True" />
                    <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Sistema" Binding="{Binding StockSistema}" Width="90" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Contado" Width="100"
                                        Binding="{Binding Conteo, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Dif." Binding="{Binding Diferencia}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}"
                   TextWrapping="Wrap" Margin="2,12,0,0"
                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}"
                    Command="{Binding CancelarCommand}" Margin="0,0,10,0" MinWidth="120" />
            <Button Content="Aplicar ajustes" Style="{StaticResource Button.Primary}"
                    Command="{Binding AplicarCommand}" MinWidth="160"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InverseBool}}" />
        </StackPanel>
    </Grid>
</Window>
