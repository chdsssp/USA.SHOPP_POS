<UserControl x:Class="Usashopp.Pos.Wpf.Features.Inventario.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inv="clr-namespace:Usashopp.Pos.Wpf.Features.Inventario"
             d:DataContext="{d:DesignInstance inv:InventarioViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de herramientas -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource TextBox.Base}" MaxWidth="420" HorizontalAlignment="Left"
                     Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding CargarCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <CheckBox Grid.Column="1" Content="Solo bajo stock" VerticalAlignment="Center" Margin="16,0"
                      IsChecked="{Binding SoloBajoStock}" />

            <Button Grid.Column="2" Content="Ajustar stock" Style="{StaticResource Button.Secondary}"
                    Command="{Binding AjustarStockCommand}" Margin="0,0,10,0" />

            <Button Grid.Column="3" Content="Editar producto" Style="{StaticResource Button.Secondary}"
                    Command="{Binding EditarProductoCommand}" Margin="0,0,10,0" />

            <Button Grid.Column="4" Content="Nuevo producto" Style="{StaticResource Button.Primary}"
                    Command="{Binding NuevoProductoCommand}" />
        </Grid>

        <!-- Tabla de inventario -->
        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Seleccionada}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="{StaticResource Brush.Surface}" RowHeight="44"
                      HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                      FontFamily="{StaticResource Font.Ui}" FontSize="13"


                      SelectionMode="Single">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AjustarStockCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="2*" />
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*" />
                    <DataGridTextColumn Header="Talla" Binding="{Binding Talla}" Width="80" />
                    <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="90" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130" />
                    <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Stock" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="999" Padding="10,3" HorizontalAlignment="Left"
                                        Background="{StaticResource Brush.Success.Bg}">
                                    <TextBlock Text="{Binding Stock}" Foreground="{StaticResource Brush.Text}"
                                               FontWeight="SemiBold" FontSize="12" />
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Brush.Success.Bg}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BajoStock}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Warning.Bg}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
                <TextBlock Text="Sin productos. Agrega uno con «Nuevo producto»." VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Items.Count, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
