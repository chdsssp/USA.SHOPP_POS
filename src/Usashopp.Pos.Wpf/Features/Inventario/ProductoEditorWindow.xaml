<Window x:Class="Usashopp.Pos.Wpf.Features.Inventario.ProductoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inv="clr-namespace:Usashopp.Pos.Wpf.Features.Inventario"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance inv:ProductoEditorViewModel}"
        Title="Nuevo producto" Height="640" Width="760" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nuevo producto" FontSize="{StaticResource Font.Title}"
                   FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Datos del producto -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Nombre" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Marca" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Marca}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="Categoría" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}"
                              DisplayMemberPath="Nombre" MinHeight="44" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <TextBlock Text="Descripción (opcional)" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Descripcion}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Variantes -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <TextBlock Text="Variantes (talla / color)" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="+ Agregar variante" Style="{StaticResource Button.Subtle}"
                            HorizontalAlignment="Right" Command="{Binding AgregarVarianteCommand}" />
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Variantes}" AutoGenerateColumns="False"
                          HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          BorderThickness="0" Background="{StaticResource Brush.Surface}" RowHeight="40"
                          HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130" />
                        <DataGridTextColumn Header="Cód. barras" Binding="{Binding CodigoBarras}" Width="130" />
                        <DataGridTextColumn Header="Talla" Binding="{Binding Talla}" Width="70" />
                        <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="80" />
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="80" />
                        <DataGridTextColumn Header="Costo" Binding="{Binding Costo}" Width="80" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockInicial}" Width="60" />
                        <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" Width="60" />
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" ToolTip="Quitar variante"
                                            Command="{Binding DataContext.QuitarVarianteCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource Brush.Critical}" Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Error -->
        <TextBlock Grid.Row="3" Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}"
                   Margin="2,12,0,0" TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <!-- Acciones -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}"
                    Command="{Binding CancelarCommand}" Margin="0,0,10,0" MinWidth="120" />
            <Button Content="Guardar producto" Style="{StaticResource Button.Primary}"
                    Command="{Binding GuardarCommand}" IsEnabled="{Binding Guardando, Converter={StaticResource InverseBool}}"
                    MinWidth="160" />
        </StackPanel>
    </Grid>
</Window>
