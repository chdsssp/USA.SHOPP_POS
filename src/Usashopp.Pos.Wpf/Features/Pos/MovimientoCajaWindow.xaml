<Window x:Class="Usashopp.Pos.Wpf.Features.Pos.MovimientoCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pos="clr-namespace:Usashopp.Pos.Wpf.Features.Pos"
        xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance pos:MovimientoCajaViewModel}"
        Title="Movimientos de caja" Height="600" Width="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Movimientos de caja" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" />

        <!-- Sin caja -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0"
                Visibility="{Binding SinCaja, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="No hay una caja abierta. Abre la caja para registrar movimientos."
                       Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
        </Border>

        <!-- Estado de caja (reporte X) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0"
                Visibility="{Binding SinCaja, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <TextBlock Text="Estado actual (corte parcial)" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,3">
                    <TextBlock Text="Fondo inicial" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Fondo, StringFormat=C2}" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,0,0,3">
                    <TextBlock Text="Efectivo por ventas" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding TotalEfectivo, StringFormat=C2}" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,0,0,3">
                    <TextBlock Text="Ingresos" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Ingresos, StringFormat=C2}" HorizontalAlignment="Right"
                               Foreground="{StaticResource Brush.Success}" />
                </Grid>
                <Grid Margin="0,0,0,3">
                    <TextBlock Text="Retiros / gastos" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Brush.Critical}">
                        <Run Text="−" /><Run Text="{Binding Salidas, StringFormat=C2, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,4,0,0">
                    <Grid>
                        <TextBlock Text="Efectivo esperado" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EfectivoEsperado, StringFormat=C2}" HorizontalAlignment="Right"
                                   FontWeight="Bold" FontSize="16" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Alta de movimiento -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"
                Visibility="{Binding SinCaja, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <TextBlock Text="Registrar movimiento" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" SelectedIndex="{Binding TipoIndex}" MinHeight="40" Width="130" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Ingreso" />
                        <ComboBoxItem Content="Retiro" />
                        <ComboBoxItem Content="Gasto" />
                    </ComboBox>
                    <TextBox Grid.Column="2" Style="{StaticResource TextBox.Base}" Width="120" MinWidth="0" Tag="Monto"
                             common:InputHelpers.SoloNumeros="True"
                             Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                    <TextBox Grid.Column="4" Style="{StaticResource TextBox.Base}" MinWidth="0" Tag="Concepto (opcional)"
                             Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="6" Content="Registrar" Style="{StaticResource Button.Primary}" MinWidth="120"
                            Command="{Binding RegistrarCommand}" IsEnabled="{Binding Ocupado, Converter={StaticResource InverseBool}}" />
                </Grid>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" Margin="0,10,0,0"
                           TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>

        <!-- Lista de movimientos -->
        <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True" Margin="0,12,0,0"
                Visibility="{Binding SinCaja, Converter={StaticResource InverseBoolToVis}}">
            <Grid>
                <DataGrid ItemsSource="{Binding Movimientos}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="38"
                          Background="{StaticResource Brush.Surface}"
                          HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding Fecha, StringFormat=HH:mm}" Width="70" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110" />
                        <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" />
                        <DataGridTextColumn Header="Efecto" Binding="{Binding Efecto, StringFormat=C2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Sin movimientos en esta sesión." VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Movimientos.Count, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cerrar" Style="{StaticResource Button.Secondary}" MinWidth="120" Click="OnCerrar" />
        </StackPanel>
    </Grid>
</Window>
