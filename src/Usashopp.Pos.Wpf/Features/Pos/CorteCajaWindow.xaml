<Window x:Class="Usashopp.Pos.Wpf.Features.Pos.CorteCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pos="clr-namespace:Usashopp.Pos.Wpf.Features.Pos"
        xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance pos:CorteCajaViewModel}"
        Title="Corte de caja" SizeToContent="Height" Width="440" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">

    <StackPanel Margin="24">
        <TextBlock Text="Corte de caja" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" />

        <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Fondo inicial" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Fondo, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Ventas" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                        <Run Text="{Binding NumVentas, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TotalVentas, StringFormat=C2, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Efectivo cobrado" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding TotalEfectivo, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Ingresos" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Ingresos, StringFormat=C2}" HorizontalAlignment="Right"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Retiros / gastos" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Brush.Critical}">
                        <Run Text="−" /><Run Text="{Binding Salidas, StringFormat=C2, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
                    <Grid>
                        <TextBlock Text="Efectivo esperado" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EfectivoEsperado, StringFormat=C2}" HorizontalAlignment="Right"
                                   FontWeight="Bold" FontSize="16" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="Efectivo contado" Foreground="{StaticResource Brush.Text.Secondary}" Margin="2,16,0,4" />
        <TextBox Style="{StaticResource TextBox.Base}" FontSize="18" FontWeight="SemiBold"
                 common:InputHelpers.SoloNumeros="True"
                 Text="{Binding MontoContado, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

        <Grid Margin="2,12,2,0">
            <TextBlock Text="Diferencia" Foreground="{StaticResource Brush.Text.Secondary}" />
            <TextBlock Text="{Binding Diferencia, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" />
        </Grid>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" Margin="2,10,0,0"
                   TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}"
                    Command="{Binding CancelarCommand}" Margin="0,0,10,0" MinWidth="120" />
            <Button Content="Cerrar caja" Style="{StaticResource Button.Primary}"
                    Command="{Binding CerrarCajaCommand}" MinWidth="150" />
        </StackPanel>
    </StackPanel>
</Window>
