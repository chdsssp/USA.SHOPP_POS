<UserControl x:Class="Usashopp.Pos.Wpf.Features.Pos.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pos="clr-namespace:Usashopp.Pos.Wpf.Features.Pos"
             xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance pos:PosViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>

        <!-- Botón del conmutador Búsqueda/Grid (activo vía Tag booleano) -->
        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{StaticResource Font.Small}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="20,8" MinHeight="{StaticResource TouchTarget.Min}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                <DataTrigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </DataTrigger.Value>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de resultado de búsqueda -->
        <Style x:Key="SearchRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="0,0,0,1" Padding="14,10" MinHeight="{StaticResource TouchTarget.Grande}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                        Background="{Binding Descripcion, Converter={StaticResource ColorFromString}}">
                                    <TextBlock Text="{Binding Descripcion, Converter={StaticResource Initials}}"
                                               Foreground="{StaticResource Brush.OnColor}" FontWeight="Bold" FontSize="{StaticResource Font.Body}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Background="{StaticResource Brush.Bg.App}" CornerRadius="5" Padding="6,1">
                                            <TextBlock Text="{Binding Sku}" FontSize="{StaticResource Font.Caption}" FontFamily="{StaticResource Font.Mono}"
                                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                                        </Border>
                                        <Border x:Name="badge" CornerRadius="999" Padding="8,1" Margin="8,0,0,0"
                                                Background="{StaticResource Brush.Success.Bg}">
                                            <TextBlock x:Name="badgeTxt" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Success}">
                                                <Run Text="{Binding Stock, Mode=OneWay}" /><Run Text=" pz" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Precio, StringFormat=C2}" FontWeight="SemiBold"
                                           FontSize="{StaticResource Font.Body}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Pressed}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding BajoStock}" Value="True">
                                <Setter TargetName="badge" Property="Background" Value="{StaticResource Brush.Warning.Bg}" />
                                <Setter TargetName="badgeTxt" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de producto (grid táctil) con animación al pasar el cursor -->
        <Style x:Key="ProductCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="152" Height="132" Margin="6" Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="72" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="11,11,0,0"
                                        Background="{Binding Descripcion, Converter={StaticResource ColorFromString}}">
                                    <TextBlock Text="{Binding Descripcion, Converter={StaticResource Initials}}"
                                               Foreground="{StaticResource Brush.OnColor}" FontSize="{StaticResource Font.Display}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Row="1" Margin="10,6,10,8">
                                    <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" FontSize="{StaticResource Font.Small}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Precio, StringFormat=C2}" FontWeight="Bold" FontSize="{StaticResource Font.Body}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Action}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- ===================== SELECCIÓN ===================== -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: búsqueda + conmutador -->
                <Grid Grid.Row="0" Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="BusquedaBox" Style="{StaticResource TextBox.Base}"
                             Tag="Escanea o busca por nombre, código o SKU…"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding BuscarCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Border Grid.Column="2" Background="{StaticResource Brush.Bg.App}" CornerRadius="{StaticResource Radius}" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Búsqueda" Style="{StaticResource SegBtn}"
                                    Tag="{Binding ModoBusqueda}" Command="{Binding UsarBusquedaCommand}" />
                            <Button Content="Grid" Style="{StaticResource SegBtn}"
                                    Tag="{Binding ModoGrid}" Command="{Binding UsarGridCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== MODO BÚSQUEDA ===== -->
                <Grid Grid.Row="1" Visibility="{Binding ModoBusqueda, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Escanea un código de barras o escribe y presiona Enter."
                               Foreground="{StaticResource Brush.Text.Disabled}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding Resultados.Count, Converter={StaticResource EmptyToVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Resultados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SearchRow}"
                                            Command="{Binding DataContext.AgregarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ===== MODO GRID ===== -->
                <Grid Grid.Row="1" Visibility="{Binding ModoGrid, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Chips de categoría -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                                  Padding="14,10,14,4">
                        <ItemsControl ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.FiltrarCategoriaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,8,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                                        CornerRadius="999" Padding="18,0" MinHeight="{StaticResource TouchTarget.Min}">
                                                    <TextBlock x:Name="t" VerticalAlignment="Center" Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="{StaticResource Font.Small}"
                                                               Foreground="{StaticResource Brush.Text.Secondary}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Action}" />
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Action}" />
                                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Brush.OnAction}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Tarjetas -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding ProductosGrid}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProductCard}"
                                            Command="{Binding DataContext.AgregarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== TICKET ===================== -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Estado de caja -->
                <Grid Grid.Row="0" Margin="16,14,16,0">
                    <Border Background="{StaticResource Brush.Success.Bg}" CornerRadius="8" Padding="12,8"
                            Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CajaTexto}" Foreground="{StaticResource Brush.Success}"
                                       FontWeight="SemiBold" FontSize="{StaticResource Font.Small}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Brush.Warning.Bg}" CornerRadius="8" Padding="12,6"
                            Visibility="{Binding CajaAbierta, Converter={StaticResource InverseBoolToVis}}">
                        <Grid>
                            <TextBlock Text="Caja cerrada" Foreground="{StaticResource Brush.Warning}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="Abrir caja" Style="{StaticResource Button.Secondary}"
                                    HorizontalAlignment="Right" MinHeight="{StaticResource TouchTarget.Min}" Padding="12,4"
                                    Command="{Binding AbrirCajaCommand}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Header ticket -->
                <Grid Grid.Row="1" Margin="16,14,16,8">
                    <TextBlock Text="Ticket" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Font.Small}">
                        <Run Text="{Binding CantidadArticulos}" /><Run Text=" art." />
                    </TextBlock>
                </Grid>

                <!-- Líneas -->
                <Grid Grid.Row="2">
                    <TextBlock Text="Busca o toca un producto para empezar." VerticalAlignment="Center"
                               HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text.Disabled}"
                               Visibility="{Binding CarritoVacio, Converter={StaticResource BoolToVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Carrito}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Descripcion}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <!-- Quitar: objetivo táctil completo de 48×48 -->
                                            <Button Grid.Row="0" Grid.Column="1" Content="✕" ToolTip="Quitar" Style="{StaticResource Button.Icon}"
                                                    Margin="0,-6,-10,0"
                                                    Command="{Binding DataContext.QuitarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="–" Style="{StaticResource Button.Icon.Outline}" ToolTip="Una pieza menos"
                                                        Command="{Binding DataContext.DecrementarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="{StaticResource TouchTarget.Comodo}"
                                                         TextAlignment="Center" FontWeight="SemiBold" Style="{StaticResource TextBox.Base}"
                                                         Padding="4,8" Margin="{StaticResource Margen.Tactil.H}"
                                                         common:InputHelpers.SoloNumeros="True"
                                                         ToolTip="Cantidad (puedes teclearla)" />
                                                <Button Content="+" Style="{StaticResource Button.Icon.Outline}" ToolTip="Una pieza más"
                                                        Command="{Binding DataContext.IncrementarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <!-- Precio: editable con permiso, solo lectura sin él -->
                                                <TextBox Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="12,0,0,0"
                                                         Style="{StaticResource TextBox.Base}" Padding="8" Tag="Precio"
                                                         common:InputHelpers.SoloNumeros="True"
                                                         ToolTip="Precio de venta (editable)"
                                                         Visibility="{Binding DataContext.PuedeDescuento, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding PrecioVenta, StringFormat=C2}" VerticalAlignment="Center"
                                                           Margin="12,0,0,0" Foreground="{StaticResource Brush.Text.Secondary}"
                                                           Visibility="{Binding DataContext.PuedeDescuento, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVis}}" />
                                                <Button Content="%" ToolTip="Descuento de línea" Style="{StaticResource Button.Icon.Outline}" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.DescontarLineaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.PuedeDescuento, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Importe, StringFormat=C2}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Foreground="{StaticResource Brush.Critical}" FontSize="{StaticResource Font.Caption}" HorizontalAlignment="Right"
                                                           Visibility="{Binding TieneDescuento, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="− " /><Run Text="{Binding DescuentoMonto, StringFormat=C2, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Aviso de existencia insuficiente (el bloqueo definitivo es al cobrar). -->
                                            <Border Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                    Background="{StaticResource Brush.Warning.Bg}" CornerRadius="999" Padding="10,2"
                                                    Visibility="{Binding ExcedeStock, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding AvisoStock}" Foreground="{StaticResource Brush.Warning}"
                                                           FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Totales -->
                <StackPanel Grid.Row="3" Background="{StaticResource Brush.Surface.Subdued}">
                    <StackPanel Margin="16,14,16,16">
                        <!-- Cliente: botón que abre el buscador táctil (antes un ComboBox con todos los clientes). -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Button.Secondary}" HorizontalContentAlignment="Stretch"
                                    MinHeight="{StaticResource TouchTarget.Comodo}" Padding="14,6" Command="{Binding ElegirClienteCommand}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ClienteTexto}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ClienteResumen}" FontSize="{StaticResource Font.Caption}" FontWeight="Normal"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               Visibility="{Binding ClienteResumen, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource Button.Icon}" Margin="8,0,0,0" ToolTip="Quitar cliente"
                                    Command="{Binding QuitarClienteCommand}"
                                    Visibility="{Binding TieneCliente, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBox Style="{StaticResource TextBox.Base}" MinHeight="{StaticResource TouchTarget.Min}" Margin="0,0,0,12"
                                 Tag="Notas de la venta (opcional)"
                                 Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Subtotal" Foreground="{StaticResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding Subtotal, StringFormat=C2}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                        </Grid>
                        <Grid Margin="0,0,0,2" Visibility="{Binding TieneDescuentoGlobal, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Descuento" Foreground="{StaticResource Brush.Critical}" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Brush.Critical}">
                                <Run Text="− " /><Run Text="{Binding DescuentoGlobalMonto, StringFormat=C2, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding ImpuestoEtiqueta}" Foreground="{StaticResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding Impuesto, StringFormat=C2}" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Text.Secondary}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Total" FontSize="{StaticResource Font.Display}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Total, StringFormat=C2}" FontSize="{StaticResource Font.Display}"
                                       FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>

                        <Button Content="Descuento a la venta" Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left"
                                Padding="0,4" Margin="0,4,0,0" Command="{Binding DescuentoGlobalCommand}"
                                Visibility="{Binding PuedeDescuento, Converter={StaticResource BoolToVis}}" />

                        <Button Content="Autorizar descuento (supervisor)" Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left"
                                Padding="0,4" Margin="0,4,0,0" Command="{Binding AutorizarDescuentoCommand}"
                                Foreground="{StaticResource Brush.Text.Secondary}"
                                Visibility="{Binding MostrarBotonAutorizarDescuento, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Suspender" Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,6,0" Command="{Binding SuspenderVentaCommand}" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Margin="6,0,0,0"
                                    Command="{Binding RecuperarVentaCommand}">
                                <TextBlock><Run Text="En espera (" /><Run Text="{Binding EnEsperaCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </Button>
                        </Grid>

                        <Button Style="{StaticResource Button.Primary}" MinHeight="{StaticResource TouchTarget.Cobrar}"
                                Margin="0,8,0,0" Command="{Binding CobrarCommand}" IsEnabled="{Binding PuedeCobrar}">
                            <TextBlock>
                                <Run Text="Cobrar  " /><Run Text="{Binding Total, StringFormat=C2, Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== RESULTADO DE LA VENTA ===================== -->
        <!-- Queda visible hasta que el cajero continúe (Nueva venta, escanear o tocar un producto). -->
        <Border Grid.ColumnSpan="3" Background="{StaticResource Brush.Overlay}"
                Visibility="{Binding MostrandoResultado, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="520" Padding="40,32">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource Brush.Success}"
                               FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold">
                        <Run Text="Venta " /><Run Text="{Binding UltimoResultado.Folio, Mode=OneWay}" /><Run Text=" registrada" />
                    </TextBlock>
                    <TextBlock Text="Cambio" HorizontalAlignment="Center" Margin="0,20,0,0"
                               Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Font.Title}" />
                    <TextBlock Text="{Binding UltimoResultado.Cambio, StringFormat=C2}" HorizontalAlignment="Center"
                               FontSize="{StaticResource Font.Hero}" FontWeight="Bold" />
                    <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Font.Subtitle}">
                        <Run Text="Total " /><Run Text="{Binding UltimoResultado.Total, StringFormat=C2, Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding UltimoResultado.Pagos}" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}">
                                    <Run Text="{Binding Metodo, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Monto, StringFormat=C2, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Avisos no fatales (impresora / cajón) -->
                    <ItemsControl ItemsSource="{Binding UltimoResultado.Advertencias}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.Warning.Bg}" CornerRadius="{StaticResource Radius}"
                                        Padding="14,10" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource Brush.Warning}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource Espacio.Tactil.Col}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Reimprimir ticket" Style="{StaticResource Button.Secondary}"
                                MinHeight="{StaticResource TouchTarget.Comodo}" Command="{Binding ReimprimirUltimaCommand}" />
                        <Button Grid.Column="2" Content="Ver ticket" Style="{StaticResource Button.Secondary}"
                                MinHeight="{StaticResource TouchTarget.Comodo}" Command="{Binding VerTicketUltimaCommand}" />
                    </Grid>
                    <Button Content="Nueva venta" Style="{StaticResource Button.Primary}" Margin="0,12,0,0"
                            MinHeight="{StaticResource TouchTarget.Grande}" FontSize="{StaticResource Font.Subtitle}"
                            Command="{Binding NuevaVentaCommand}" IsDefault="True" />
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== TOAST ===================== -->
        <Border Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                Background="{StaticResource Brush.Action}" CornerRadius="10" Padding="18,12" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform Y="20" />
            </Border.RenderTransform>
            <TextBlock Text="{Binding ToastMensaje}" Foreground="{StaticResource Brush.OnColor}" FontWeight="SemiBold" FontSize="{StaticResource Font.Small}" />
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="20" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
