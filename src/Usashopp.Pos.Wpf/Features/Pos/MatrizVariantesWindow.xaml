<Window x:Class="Usashopp.Pos.Wpf.Features.Pos.MatrizVariantesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elegir talla y color" SizeToContent="WidthAndHeight" MinWidth="460" MaxWidth="1200" MaxHeight="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado: foto + nombre -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="{StaticResource Radius}" ClipToBounds="True"
                    Background="{Binding Nombre, Converter={StaticResource ColorFromString}}" Margin="0,0,14,0">
                <Grid>
                    <TextBlock Text="{Binding Nombre, Converter={StaticResource Initials}}" Foreground="{StaticResource Brush.OnColor}"
                               FontWeight="Bold" FontSize="{StaticResource Font.Title}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding ImagenRuta, Converter={StaticResource RutaAImagen}}" Stretch="UniformToFill" />
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Toca la talla y el color. El número es la existencia."
                           Foreground="{StaticResource Brush.Text.Secondary}" />
            </StackPanel>
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <RadioButton x:Name="UnaPieza" GroupName="Modo" Content="Agregar 1 y cerrar" Style="{StaticResource Segmento}" IsChecked="True" />
            <RadioButton x:Name="VariasPiezas" GroupName="Modo" Content="Agregar varias" Style="{StaticResource Segmento}" />
        </WrapPanel>

        <!-- Tabla talla × color (se arma en código) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both">
                <Grid x:Name="Tabla" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource Espacio.Tactil.Col}" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource Button.Secondary}"
                    MinHeight="{StaticResource TouchTarget.Comodo}" Click="OnCancelar" />
            <Button Grid.Column="2" x:Name="Agregar" Style="{StaticResource Button.Primary}"
                    MinHeight="{StaticResource TouchTarget.Comodo}" Click="OnAgregar" IsEnabled="False" Content="Agregar al carrito" />
        </Grid>
    </Grid>
</Window>
