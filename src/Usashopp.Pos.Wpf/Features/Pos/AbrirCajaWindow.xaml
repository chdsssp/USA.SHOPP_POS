<Window x:Class="Usashopp.Pos.Wpf.Features.Pos.AbrirCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pos="clr-namespace:Usashopp.Pos.Wpf.Features.Pos"
        xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance pos:AbrirCajaViewModel}"
        Title="Abrir caja" SizeToContent="Height" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">

    <StackPanel Margin="24">
        <TextBlock Text="Abrir caja" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" />
        <TextBlock Text="Captura el fondo inicial con el que abre la caja." Margin="0,4,0,0"
                   Foreground="{StaticResource Brush.Text.Secondary}" />

        <TextBlock Text="Fondo inicial" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,18,0,4" />
        <TextBox Style="{StaticResource TextBox.Base}" FontSize="20" FontWeight="SemiBold"
                 common:InputHelpers.SoloNumeros="True"
                 Text="{Binding FondoInicial, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="$500" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                    Command="{Binding FijarCommand}" CommandParameter="500" />
            <Button Content="$1,000" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                    Command="{Binding FijarCommand}" CommandParameter="1000" />
            <Button Content="$1,500" Style="{StaticResource Button.Secondary}"
                    Command="{Binding FijarCommand}" CommandParameter="1500" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}"
                    Command="{Binding CancelarCommand}" Margin="0,0,10,0" MinWidth="110" />
            <Button Content="Abrir caja" Style="{StaticResource Button.Primary}"
                    Command="{Binding AceptarCommand}" MinWidth="130" />
        </StackPanel>
    </StackPanel>
</Window>
