<Window x:Class="Usashopp.Pos.Wpf.Features.Pos.CobroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pos="clr-namespace:Usashopp.Pos.Wpf.Features.Pos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance pos:CobroViewModel}"
        Title="Cobrar" Height="740" Width="500" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">

    <Window.Resources>
        <Style x:Key="Tecla" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="MetodoBtn" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinHeight" Value="46" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Total y faltante -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total a cobrar" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Total, StringFormat=C2}" FontSize="30" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Por cobrar" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Faltante, StringFormat=C2}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Método + agregar -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Efectivo" Style="{StaticResource MetodoBtn}" Margin="0,0,8,0"
                    Command="{Binding UsarEfectivoCommand}" />
            <Button Grid.Column="1" Content="Tarjeta" Style="{StaticResource MetodoBtn}" Margin="0,0,8,0"
                    Command="{Binding UsarTarjetaCommand}" />
            <Button Grid.Column="2" Content="+ Agregar pago" Style="{StaticResource MetodoBtn}" MinWidth="140"
                    Command="{Binding AgregarPagoCommand}" IsEnabled="{Binding PuedeAgregar}"
                    ToolTip="Registra este importe y captura otro (pago mixto)" />
        </Grid>

        <!-- Recibido / cambio + pagos capturados -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Capturando" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" />
                        <TextBlock Text="{Binding MontoRecibido, StringFormat=C2}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Cambio" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Cambio, StringFormat=C2}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Success}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Pagos}" Margin="0,12,0,0"
                              Visibility="{Binding HayPagos, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.Selected}" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold" FontSize="12.5">
                                        <Run Text="{Binding MetodoTexto, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Monto, StringFormat=C2, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="✕" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{StaticResource Brush.Accent}" FontSize="12" Padding="2,0"
                                            Command="{Binding DataContext.QuitarPagoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Teclado y montos rápidos -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Columns="3" Rows="4">
                <Button Content="1" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="1" />
                <Button Content="2" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="2" />
                <Button Content="3" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="3" />
                <Button Content="4" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="4" />
                <Button Content="5" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="5" />
                <Button Content="6" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="6" />
                <Button Content="7" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="7" />
                <Button Content="8" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="8" />
                <Button Content="9" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="9" />
                <Button Content="00" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="00" />
                <Button Content="0" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="0" />
                <Button Content="⌫" Style="{StaticResource Tecla}" Command="{Binding BorrarCommand}" />
            </UniformGrid>

            <StackPanel Grid.Column="2">
                <Button Content="$100" Style="{StaticResource Tecla}" Command="{Binding MontoRapidoCommand}" CommandParameter="100" />
                <Button Content="$200" Style="{StaticResource Tecla}" Command="{Binding MontoRapidoCommand}" CommandParameter="200" />
                <Button Content="$500" Style="{StaticResource Tecla}" Command="{Binding MontoRapidoCommand}" CommandParameter="500" />
                <Button Content="Exacto" Style="{StaticResource Tecla}"
                        Command="{Binding MontoExactoCommand}" ToolTip="Captura el importe que falta por cobrar" />
            </StackPanel>
        </Grid>

        <!-- Acciones -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}"
                    Command="{Binding CancelarCommand}" Margin="0,0,10,0" MinWidth="120" />
            <Button Content="Confirmar cobro" Style="{StaticResource Button.Primary}"
                    Command="{Binding ConfirmarCommand}" IsEnabled="{Binding PuedeConfirmar}"
                    MinWidth="170" MinHeight="52" />
        </StackPanel>
    </Grid>
</Window>
