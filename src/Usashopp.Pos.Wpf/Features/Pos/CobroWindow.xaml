<Window x:Class="Usashopp.Pos.Wpf.Features.Pos.CobroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pos="clr-namespace:Usashopp.Pos.Wpf.Features.Pos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance pos:CobroViewModel}"
        Title="Cobrar" Height="640" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">

    <Window.Resources>
        <Style x:Key="Tecla" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="MetodoBtn" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinHeight" Value="48" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Total y método -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Total a cobrar" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Total, StringFormat=C2}" FontSize="34" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Efectivo" Style="{StaticResource MetodoBtn}" Width="150" Margin="0,0,10,0"
                    Command="{Binding UsarEfectivoCommand}" />
            <Button Content="Tarjeta" Style="{StaticResource MetodoBtn}" Width="150"
                    Command="{Binding UsarTarjetaCommand}" />
        </StackPanel>

        <!-- Recibido / cambio -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Recibido" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding MontoRecibido, StringFormat=C2}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Cambio" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Cambio, StringFormat=C2}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Success}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Teclado y montos rápidos -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Columns="3" Rows="4">
                <Button Content="1" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="1" />
                <Button Content="2" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="2" />
                <Button Content="3" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="3" />
                <Button Content="4" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="4" />
                <Button Content="5" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="5" />
                <Button Content="6" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="6" />
                <Button Content="7" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="7" />
                <Button Content="8" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="8" />
                <Button Content="9" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="9" />
                <Button Content="00" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="00" />
                <Button Content="0" Style="{StaticResource Tecla}" Command="{Binding TeclaCommand}" CommandParameter="0" />
                <Button Content="⌫" Style="{StaticResource Tecla}" Command="{Binding BorrarCommand}" />
            </UniformGrid>

            <StackPanel Grid.Column="2">
                <Button Content="$100" Style="{StaticResource Tecla}" Command="{Binding MontoRapidoCommand}" CommandParameter="100" />
                <Button Content="$200" Style="{StaticResource Tecla}" Command="{Binding MontoRapidoCommand}" CommandParameter="200" />
                <Button Content="$500" Style="{StaticResource Tecla}" Command="{Binding MontoRapidoCommand}" CommandParameter="500" />
                <Button Content="Exacto" Style="{StaticResource Tecla}"
                        Command="{Binding MontoExactoCommand}" ToolTip="Captura el monto exacto del total" />
            </StackPanel>
        </Grid>

        <!-- Acciones -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}"
                    Command="{Binding CancelarCommand}" Margin="0,0,10,0" MinWidth="120" />
            <Button Content="Confirmar cobro" Style="{StaticResource Button.Primary}"
                    Command="{Binding ConfirmarCommand}" IsEnabled="{Binding PuedeConfirmar}"
                    MinWidth="170" MinHeight="52" />
        </StackPanel>
    </Grid>
</Window>
