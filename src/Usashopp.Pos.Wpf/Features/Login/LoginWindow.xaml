<Window x:Class="Usashopp.Pos.Wpf.Features.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lg="clr-namespace:Usashopp.Pos.Wpf.Features.Login"
        xmlns:ctl="clr-namespace:Usashopp.Pos.Wpf.Common.Controles"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance lg:LoginViewModel}"
        Title="USASHOPP POS" SizeToContent="Height" Width="440" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource Font.Ui}">
    <Border Background="{StaticResource Brush.Surface}" CornerRadius="16" Margin="16"
            BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
        <StackPanel Margin="32" VerticalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource Brush.Action}" HorizontalAlignment="Center">
                <TextBlock Text="US" Foreground="{StaticResource Brush.OnColor}" FontWeight="Bold" FontSize="{StaticResource Font.Title}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="USASHOPP POS" FontSize="{StaticResource Font.Title}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,2" />
            <TextBlock Text="Inicia sesión para continuar" Foreground="{StaticResource Brush.Text.Secondary}"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />

            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                <RadioButton GroupName="Modo" Content="Con PIN" Style="{StaticResource Segmento}" IsChecked="{Binding UsarPin}" />
                <RadioButton GroupName="Modo" Content="Usuario y contraseña" Style="{StaticResource Segmento}" IsChecked="{Binding UsarContrasena}" />
            </WrapPanel>

            <!-- PIN: cambio rápido de cajero -->
            <ctl:PinPad x:Name="Pad" Pin="{Binding Pin, Mode=TwoWay}" Completado="OnPinCompletado"
                        Visibility="{Binding UsarPin, Converter={StaticResource BoolToVis}}" />

            <!-- Usuario y contraseña -->
            <StackPanel Visibility="{Binding UsarContrasena, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Usuario" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                <TextBox x:Name="UsuarioBox" Style="{StaticResource TextBox.Base}"
                         Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Contraseña" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,14,0,4" />
                <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="8"
                        Background="{StaticResource Brush.Surface.Subdued}">
                    <PasswordBox x:Name="Password" MinHeight="{StaticResource TouchTarget.Min}" Padding="12,8" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0" FontSize="{StaticResource Font.Body}"
                                 KeyDown="OnPasswordKeyDown" />
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" Margin="0,12,0,0"
                       TextWrapping="Wrap" HorizontalAlignment="Center"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

            <Button Content="Iniciar sesión" Style="{StaticResource Button.Primary}" MinHeight="{StaticResource TouchTarget.Comodo}"
                    Margin="0,20,0,0" Click="OnLogin"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InverseBool}}" />
        </StackPanel>
    </Border>
</Window>
