<Window x:Class="Usashopp.Pos.Wpf.Features.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lg="clr-namespace:Usashopp.Pos.Wpf.Features.Login"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance lg:LoginViewModel}"
        Title="USASHOPP POS" Height="520" Width="420" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource Font.Ui}">
    <Border Background="{StaticResource Brush.Surface}" CornerRadius="16" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel Margin="36" VerticalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource Brush.Action}" HorizontalAlignment="Center">
                <TextBlock Text="US" Foreground="White" FontWeight="Bold" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="USASHOPP POS" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,2" />
            <TextBlock Text="Inicia sesión para continuar" Foreground="{StaticResource Brush.Text.Secondary}"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />

            <TextBlock Text="Usuario" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
            <TextBox x:Name="UsuarioBox" Style="{StaticResource TextBox.Base}"
                     Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Contraseña" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,14,0,4" />
            <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="8"
                    Background="{StaticResource Brush.Surface.Subdued}">
                <PasswordBox x:Name="Password" MinHeight="44" Padding="12,8" VerticalContentAlignment="Center"
                             Background="Transparent" BorderThickness="0" FontSize="15"
                             KeyDown="OnPasswordKeyDown" />
            </Border>

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" Margin="0,12,0,0"
                       TextWrapping="Wrap" HorizontalAlignment="Center"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

            <Button Content="Iniciar sesión" Style="{StaticResource Button.Primary}" MinHeight="48"
                    Margin="0,20,0,0" Click="OnLogin"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InverseBool}}" />
        </StackPanel>
    </Border>
</Window>
