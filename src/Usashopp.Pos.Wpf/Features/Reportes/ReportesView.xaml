<UserControl x:Class="Usashopp.Pos.Wpf.Features.Reportes.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Usashopp.Pos.Wpf.Features.Reportes"
             d:DataContext="{d:DesignInstance r:ReportesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Kpi" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- Filtros -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Desde" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding Desde}" MinHeight="40" VerticalContentAlignment="Center" />
                <TextBlock Text="Hasta" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="16,0,8,0" />
                <DatePicker SelectedDate="{Binding Hasta}" MinHeight="40" VerticalContentAlignment="Center" />
                <Button Content="Actualizar" Style="{StaticResource Button.Secondary}" Command="{Binding CargarCommand}" Margin="16,0,0,0" />
                <Button Content="Exportar CSV" Style="{StaticResource Button.Secondary}" Command="{Binding ExportarCsvCommand}" Margin="10,0,0,0" />
            </StackPanel>

            <!-- KPIs -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Kpi}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Ventas del periodo" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding VentasTotal, StringFormat=C2}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11.5" Margin="0,2,0,0">
                            <Run Text="vs anterior: " /><Run Text="{Binding VariacionPct, StringFormat=P1, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Número de ventas" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding NumVentas}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Ticket promedio" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding TicketPromedio, StringFormat=C2}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Productos bajo stock" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding ProductosBajoStock}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Warning}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- KPIs de rentabilidad -->
            <UniformGrid Columns="4" Margin="0,12,0,0">
                <Border Style="{StaticResource Kpi}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Utilidad bruta (aprox.)" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding UtilidadBruta, StringFormat=C2}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Success}" Margin="0,4,0,0" />
                        <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11.5" Margin="0,2,0,0">
                            <Run Text="Costo: " /><Run Text="{Binding CostoTotal, StringFormat=C2, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Margen" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding MargenPct, StringFormat=P1}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Descuentos otorgados" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding DescuentosOtorgados, StringFormat=C2}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Critical}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Devoluciones / cancelaciones" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                        <TextBlock Text="{Binding NumDevoluciones}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11.5" Margin="0,2,0,0"
                                   Text="{Binding TotalDevoluciones, StringFormat=C2}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Inventario valorizado -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="Inventario valorizado" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
                    <UniformGrid Columns="3">
                        <StackPanel>
                            <TextBlock Text="Valor a costo" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                            <TextBlock Text="{Binding InventarioValorCosto, StringFormat=C2}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Valor a precio de venta" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                            <TextBlock Text="{Binding InventarioValorPrecio, StringFormat=C2}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Unidades en existencia" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" />
                            <TextBlock Text="{Binding InventarioUnidades}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Ventas por forma de pago -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Ventas por forma de pago" FontWeight="SemiBold" FontSize="15" Margin="16,14,16,4" />
                    <ItemsControl ItemsSource="{Binding PorMetodoPago}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Metodo}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <Run Text="{Binding NumPagos, Mode=OneWay}" /><Run Text=" pagos" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat=C2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Sin pagos en el periodo." Foreground="{StaticResource Brush.Text.Disabled}" Margin="16,12"
                               Visibility="{Binding PorMetodoPago.Count, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </Border>

            <!-- Ventas por usuario -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Ventas por usuario" FontWeight="SemiBold" FontSize="15" Margin="16,14,16,4" />
                    <ItemsControl ItemsSource="{Binding PorUsuario}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Usuario}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <Run Text="{Binding NumVentas, Mode=OneWay}" /><Run Text=" ventas" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat=C2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Sin ventas en el periodo." Foreground="{StaticResource Brush.Text.Disabled}" Margin="16,12"
                               Visibility="{Binding PorUsuario.Count, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </Border>

            <!-- Ventas por categoría -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Ventas por categoría" FontWeight="SemiBold" FontSize="15" Margin="16,14,16,4" />
                    <ItemsControl ItemsSource="{Binding PorCategoria}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Categoria}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <Run Text="{Binding Unidades, Mode=OneWay}" /><Run Text=" u." />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Importe, StringFormat=C2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Sin ventas en el periodo." Foreground="{StaticResource Brush.Text.Disabled}" Margin="16,12"
                               Visibility="{Binding PorCategoria.Count, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </Border>

            <!-- Ventas por hora -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Ventas por hora del día" FontWeight="SemiBold" FontSize="15" Margin="16,14,16,4" />
                    <ItemsControl ItemsSource="{Binding PorHora}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Franja}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <Run Text="{Binding NumVentas, Mode=OneWay}" /><Run Text=" ventas" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat=C2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Sin ventas en el periodo." Foreground="{StaticResource Brush.Text.Disabled}" Margin="16,12"
                               Visibility="{Binding PorHora.Count, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </Border>

            <!-- Top productos -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Productos más vendidos" FontWeight="SemiBold" FontSize="15" Margin="16,14,16,4" />
                    <ItemsControl ItemsSource="{Binding TopProductos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Descripcion}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <Run Text="{Binding Cantidad, Mode=OneWay}" /><Run Text=" u." />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Importe, StringFormat=C2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Sin ventas en el periodo." Foreground="{StaticResource Brush.Text.Disabled}" Margin="16,12"
                               Visibility="{Binding TopProductos.Count, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </Border>

            <!-- Productos sin movimiento -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Productos sin movimiento en el periodo" FontWeight="SemiBold" FontSize="15" Margin="16,14,16,4" />
                    <ItemsControl ItemsSource="{Binding SinMovimiento}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Producto}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Sku}" Foreground="{StaticResource Brush.Text.Secondary}"
                                                   Margin="0,0,20,0" VerticalAlignment="Center" FontSize="12.5" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <Run Text="{Binding Stock, Mode=OneWay}" /><Run Text=" en stock" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Todos los productos tuvieron movimiento." Foreground="{StaticResource Brush.Text.Disabled}" Margin="16,12"
                               Visibility="{Binding SinMovimiento.Count, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
