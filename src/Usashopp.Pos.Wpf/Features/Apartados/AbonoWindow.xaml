<Window x:Class="Usashopp.Pos.Wpf.Features.Apartados.AbonoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ap="clr-namespace:Usashopp.Pos.Wpf.Features.Apartados"
        xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance ap:AbonoViewModel}"
        Title="Registrar abono" Height="360" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <StackPanel Margin="24">
        <TextBlock Text="Registrar abono" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.Text.Secondary}">
            <Run Text="Apartado " /><Run Text="{Binding Folio, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
        </TextBlock>

        <Grid Margin="0,16,0,0">
            <TextBlock Text="Saldo pendiente" Foreground="{StaticResource Brush.Text.Secondary}" />
            <TextBlock Text="{Binding Saldo, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" />
        </Grid>

        <TextBlock Text="Monto del abono" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,16,0,4" />
        <TextBox Style="{StaticResource TextBox.Base}" FontSize="18" FontWeight="SemiBold"
                 common:InputHelpers.SoloNumeros="True"
                 Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

        <TextBlock Text="Método" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,4" />
        <ComboBox ItemsSource="{Binding Metodos}" SelectedItem="{Binding Metodo}" MinHeight="40" VerticalContentAlignment="Center" />

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}" Command="{Binding CancelarCommand}"
                    Margin="0,0,10,0" MinWidth="110" />
            <Button Content="Registrar" Style="{StaticResource Button.Primary}" Command="{Binding GuardarCommand}" MinWidth="130" />
        </StackPanel>
    </StackPanel>
</Window>
