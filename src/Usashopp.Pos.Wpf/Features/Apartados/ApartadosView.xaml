<UserControl x:Class="Usashopp.Pos.Wpf.Features.Apartados.ApartadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="clr-namespace:Usashopp.Pos.Wpf.Features.Apartados"
             d:DataContext="{d:DesignInstance ap:ApartadosViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
            <Button Content="Nuevo apartado" Style="{StaticResource Button.Primary}" Command="{Binding NuevoCommand}" />
            <Button Content="Abonar" Style="{StaticResource Button.Secondary}" Command="{Binding AbonarCommand}" Margin="10,0,0,0" />
            <Button Content="Liquidar" Style="{StaticResource Button.Secondary}" Command="{Binding LiquidarCommand}" Margin="10,0,0,0" />
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}" Command="{Binding CancelarApartadoCommand}" Margin="10,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Apartados}" SelectedItem="{Binding Seleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42"
                      Background="{StaticResource Brush.Surface}"

                      HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                      FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="110" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="100" />
                    <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat=C2}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Detalle -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <TextBlock Text="Selecciona un apartado para ver su detalle." VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                           Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Detalle, Converter={StaticResource NullToCollapsed}, ConverterParameter=inv}" />

                <Grid Visibility="{Binding Detalle, Converter={StaticResource NullToCollapsed}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="16,14">
                        <TextBlock Text="{Binding Detalle.Folio}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detalle.Cliente}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Detalle.Lineas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12">
                                                        <Run Text="{Binding Cantidad, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding PrecioUnitario, StringFormat=C2, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Importe, StringFormat=C2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Abonos" FontWeight="SemiBold" Margin="16,14,16,4" />
                            <ItemsControl ItemsSource="{Binding Detalle.Abonos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,4">
                                            <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5">
                                                <Run Text="{Binding Fecha, StringFormat=dd/MM/yyyy, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Metodo, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Monto, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Background="{StaticResource Brush.Surface.Subdued}">
                        <StackPanel Margin="16,12">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Total" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding Detalle.Total, StringFormat=C2}" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Text.Secondary}" />
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Abonado" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding Detalle.Abonado, StringFormat=C2}" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Success}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Saldo" FontWeight="Bold" FontSize="18" />
                                <TextBlock Text="{Binding Detalle.Saldo, StringFormat=C2}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
