<Window x:Class="Usashopp.Pos.Wpf.Features.Apartados.ApartadoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ap="clr-namespace:Usashopp.Pos.Wpf.Features.Apartados"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance ap:ApartadoEditorViewModel}"
        Title="Nuevo apartado" Height="670" Width="720" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nuevo apartado" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Cliente" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSeleccionado}"
                          DisplayMemberPath="Nombre" MinHeight="40" VerticalContentAlignment="Center" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Producto" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Cantidad" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Precio" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Variantes}" SelectedItem="{Binding VarianteSeleccionada}"
                              DisplayMemberPath="Descripcion" MinHeight="40" VerticalContentAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource TextBox.Base}"
                             Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource TextBox.Base}"
                             Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" TextAlignment="Center" />
                    <Button Grid.Row="1" Grid.Column="6" Content="Agregar" Style="{StaticResource Button.Secondary}"
                            Command="{Binding AgregarLineaCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeight="40" Background="{StaticResource Brush.Surface}"
                      RowBackground="{StaticResource Brush.Surface}" AlternatingRowBackground="{StaticResource Brush.Surface.Subdued}"
                      HorizontalGridLinesBrush="{StaticResource Brush.Border}" FontFamily="{StaticResource Font.Ui}" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*" />
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90" />
                    <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="110" />
                    <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C2}" Width="120" />
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" ToolTip="Quitar" Foreground="{StaticResource Brush.Critical}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.QuitarLineaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Anticipo + total -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Anticipo" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" />
            <TextBox Grid.Column="2" Style="{StaticResource TextBox.Base}"
                     Text="{Binding AnticipoInicial, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" TextAlignment="Center" />
            <TextBlock Grid.Column="4" Text="Método" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" />
            <ComboBox Grid.Column="6" ItemsSource="{Binding Metodos}" SelectedItem="{Binding MetodoAnticipo}"
                      MinHeight="40" VerticalContentAlignment="Center" />
            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Total:" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Total, StringFormat=C2}" FontWeight="Bold" FontSize="18" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" VerticalAlignment="Center"
                       Margin="0,0,16,0" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
            <Button Content="Cancelar" Style="{StaticResource Button.Secondary}" Command="{Binding CancelarCommand}"
                    Margin="0,0,10,0" MinWidth="120" />
            <Button Content="Crear apartado" Style="{StaticResource Button.Primary}" Command="{Binding GuardarCommand}"
                    IsEnabled="{Binding Guardando, Converter={StaticResource InverseBool}}" MinWidth="160" />
        </StackPanel>
    </Grid>
</Window>
