<Window x:Class="Usashopp.Pos.Wpf.Features.Clientes.HistorialClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Usashopp.Pos.Wpf.Features.Clientes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance c:HistorialClienteViewModel}"
        Title="Historial de compras" Height="520" Width="620" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titulo}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" />

        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Compras}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40"
                          Background="{StaticResource Brush.Surface}"
                          HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="120" />
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                        <DataGridTextColumn Header="Artículos" Binding="{Binding Articulos}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Este cliente no tiene compras registradas." VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding Compras.Count, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
