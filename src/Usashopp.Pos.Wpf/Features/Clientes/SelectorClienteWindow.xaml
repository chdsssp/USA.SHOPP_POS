<Window x:Class="Usashopp.Pos.Wpf.Features.Clientes.SelectorClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cli="clr-namespace:Usashopp.Pos.Wpf.Features.Clientes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance cli:SelectorClienteViewModel}"
        Title="Elegir cliente" Height="640" Width="620" MinWidth="480" MinHeight="460" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Elegir cliente" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="Busqueda" Style="{StaticResource TextBox.Base}" MinHeight="{StaticResource TouchTarget.Comodo}"
                     Tag="Nombre, teléfono, RFC o correo…" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding Aviso}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="2,6,0,0"
                       Visibility="{Binding Aviso, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Resultados}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ElegirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Style="{StaticResource Button.Subtle}"
                                    HorizontalContentAlignment="Stretch" MinHeight="{StaticResource TouchTarget.Grande}" Padding="16,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="22"
                                            Background="{Binding Nombre, Converter={StaticResource ColorFromString}}">
                                        <TextBlock Text="{Binding Nombre, Converter={StaticResource Initials}}" Foreground="{StaticResource Brush.OnColor}"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Font.Small}">
                                            <Run Text="{Binding Telefono, Mode=OneWay, TargetNullValue='sin teléfono'}" /><Run Text="  ·  " /><Run Text="{Binding Rfc, Mode=OneWay, TargetNullValue=''}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Font.Small}">
                                        <Run Text="{Binding Puntos, Mode=OneWay}" /><Run Text=" pts" />
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource Espacio.Tactil.Col}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource Espacio.Tactil.Col}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource Button.Secondary}" MinHeight="{StaticResource TouchTarget.Comodo}"
                    Command="{Binding CancelarCommand}" />
            <Button Grid.Column="2" Content="Sin cliente" Style="{StaticResource Button.Secondary}" MinHeight="{StaticResource TouchTarget.Comodo}"
                    Command="{Binding SinClienteCommand}" />
            <Button Grid.Column="4" Content="+ Nuevo cliente" Style="{StaticResource Button.Primary}" MinHeight="{StaticResource TouchTarget.Comodo}"
                    Command="{Binding NuevoCommand}" />
        </Grid>
    </Grid>
</Window>
