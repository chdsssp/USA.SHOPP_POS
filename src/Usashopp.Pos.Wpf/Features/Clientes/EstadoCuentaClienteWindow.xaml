<Window x:Class="Usashopp.Pos.Wpf.Features.Clientes.EstadoCuentaClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Usashopp.Pos.Wpf.Features.Clientes"
        xmlns:common="clr-namespace:Usashopp.Pos.Wpf.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance c:EstadoCuentaClienteViewModel}"
        Title="Estado de cuenta" Height="600" Width="600" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Ui}" Background="{StaticResource Brush.Bg.App}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titulo}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Límite de crédito" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding LimiteCredito, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Cargos a crédito" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Cargos, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Abonos" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Abonos, StringFormat=C2}" HorizontalAlignment="Right"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}" />
                </Grid>
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
                    <Grid>
                        <TextBlock Text="Saldo por cobrar" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Saldo, StringFormat=C2}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="  ·  disponible " Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Disponible, StringFormat=C2}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5">
                    <Run Text="Saldo a favor (notas de crédito): " /><Run Text="{Binding SaldoNotas, StringFormat=C2, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Abono" VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Style="{StaticResource TextBox.Base}" VerticalContentAlignment="Center"
                     common:InputHelpers.SoloNumeros="True"
                     Text="{Binding MontoAbono, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
            <TextBox Grid.Column="2" Style="{StaticResource TextBox.Base}" Margin="10,0,0,0" VerticalContentAlignment="Center"
                     Tag="Nota (opcional)" Text="{Binding Nota, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="3" Content="Registrar abono" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                    Command="{Binding RegistrarAbonoCommand}"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InverseBool}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True" Margin="0,14,0,0">
            <Grid>
                <DataGrid ItemsSource="{Binding AbonosRecientes}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="38"
                          Background="{StaticResource Brush.Surface}"
                          HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="*" />
                        <DataGridTextColumn Header="Nota" Binding="{Binding Nota}" Width="*" />
                        <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Sin abonos registrados." VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text.Disabled}"
                           Visibility="{Binding AbonosRecientes.Count, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Critical}" VerticalAlignment="Center"
                       Margin="0,0,12,0" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
            <Button Content="Cerrar" Style="{StaticResource Button.Secondary}"
                    Command="{Binding CerrarDialogoCommand}" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
