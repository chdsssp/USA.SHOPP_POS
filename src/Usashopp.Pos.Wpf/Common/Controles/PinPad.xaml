<UserControl x:Class="Usashopp.Pos.Wpf.Common.Controles.PinPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">
    <!-- Teclado de PIN táctil: los dígitos se muestran como puntos. Enter/✓ dispara Completado. -->
    <StackPanel>
        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border.Strong}"
                BorderThickness="1" CornerRadius="{StaticResource Radius}" MinHeight="{StaticResource TouchTarget.Grande}"
                Margin="4,0,4,8">
            <TextBlock x:Name="Puntos" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="{StaticResource Font.Display}" FontWeight="Bold" />
        </Border>
        <UniformGrid Columns="3" Rows="4">
            <Button Content="1" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="2" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="3" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="4" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="5" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="6" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="7" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="8" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="9" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="⌫" Style="{StaticResource Button.Tecla}" Click="OnBorrar" ToolTip="Borrar" />
            <Button Content="0" Style="{StaticResource Button.Tecla}" Click="OnDigito" />
            <Button Content="✓" Style="{StaticResource Button.Tecla}" Click="OnAceptar" ToolTip="Aceptar"
                    Background="{StaticResource Brush.Accent}" Foreground="{StaticResource Brush.OnAction}" />
        </UniformGrid>
    </StackPanel>
</UserControl>
