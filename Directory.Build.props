<Project>
  <!-- Propiedades comunes a TODOS los proyectos de la solución -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>es-MX</NeutralLanguage>
    <!-- Solo español/inglés: reduce mucho el tamaño de la publicación/instalador. -->
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <!-- Versión única de la app (la CI la reemplaza con la del tag vX.Y.Z). El instalador y el
         actualizador la leen de aquí / del ejecutable. -->
    <Version>1.2.0</Version>
  </PropertyGroup>
</Project>
